page {
  --primary: #4a6cf7;
  --primary-light: #eef1ff;
  --success: #10b981;
  --warning: #f59e0b;
  --danger: #ef4444;
  --bg: #f0f2f5;
  --card-bg: #ffffff;
  --text: #1a1a2e;
  --text-secondary: #6b7280;
  --text-muted: #9ca3af;
  --border: #e5e7eb;
  --radius: 12rpx;
  --shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);

  background-color: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  box-sizing: border-box;
}

/* 通用卡片 */
.card {
  background: var(--card-bg);
  border-radius: var(--radius);
  padding: 24rpx;
  margin: 16rpx 24rpx;
  box-shadow: var(--shadow);
}

/* 通用按钮 */
.btn-primary {
  background: var(--primary);
  color: #fff;
  border: none;
  border-radius: var(--radius);
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  text-align: center;
  display: inline-block;
}
.btn-primary:active {
  opacity: 0.85;
}

.btn-outline {
  background: #fff;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: var(--radius);
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  text-align: center;
  display: inline-block;
}

.btn-danger {
  background: var(--danger);
  color: #fff;
  border: none;
  border-radius: var(--radius);
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  text-align: center;
}

.btn-sm {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
}

/* 通用分隔线 */
.divider {
  height: 1rpx;
  background: var(--border);
  margin: 24rpx 0;
}

/* 状态标签 */
.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.tag-success { background: #d1fae5; color: #065f46; }
.tag-warning { background: #fef3c7; color: #92400e; }
.tag-danger { background: #fee2e2; color: #991b1b; }
.tag-info { background: #dbeafe; color: #1e40af; }
.tag-default { background: #f3f4f6; color: #4b5563; }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  color: var(--text-muted);
}
.empty-state .icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 24rpx;
  color: var(--text-muted);
  font-size: 24rpx;
}

/* Flex 布局快捷 */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-wrap { flex-wrap: wrap; }
.flex-center { align-items: center; justify-content: center; }
.flex-between { align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; }
