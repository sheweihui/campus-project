.page-orders {
  padding-bottom: 40rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  gap: 12rpx;
}
.search-input {
  flex: 1;
  background: #f3f4f6;
  border-radius: 10rpx;
  padding: 14rpx 20rpx;
  font-size: 26rpx;
}
.search-btn {
  background: #4a6cf7;
  color: #fff;
  padding: 14rpx 24rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
}
.filter-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 14rpx 16rpx;
  color: #6b7280;
  font-size: 26rpx;
}

/* 标签滚动 */
.tab-scroll {
  white-space: nowrap;
  background: #fff;
  border-bottom: 1rpx solid #f3f4f6;
}
.tabs {
  display: inline-flex;
  padding: 16rpx 24rpx;
  gap: 12rpx;
}
.tabs-status {
  padding-top: 0;
}
.tab-item {
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #6b7280;
  background: #f3f4f6;
  display: inline-block;
}
.tab-item.active {
  background: #4a6cf7;
  color: #fff;
}
.tab-item-sm {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #6b7280;
  background: #f3f4f6;
  display: inline-block;
}
.tab-item-sm.active {
  background: #eef1ff;
  color: #4a6cf7;
  font-weight: 500;
}

/* 筛选面板 */
.filter-panel {
  margin: 16rpx 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 12rpx;
}
.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}
.filter-label {
  font-size: 26rpx;
  color: #6b7280;
}
.filter-value {
  font-size: 26rpx;
  color: #4a6cf7;
}
.filter-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}

/* 汇总 */
.summary-bar {
  padding: 16rpx 24rpx;
  color: #9ca3af;
  font-size: 24rpx;
}

/* 订单列表 */
.order-list {
  padding: 0 24rpx;
}
.order-item {
  margin: 12rpx 0;
}
.order-header {
  margin-bottom: 12rpx;
}
.order-type-tag {
  font-size: 22rpx;
  background: #eef1ff;
  color: #4a6cf7;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
}
.order-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
}
.order-body {
  margin-bottom: 12rpx;
}
.order-people {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.6;
}
.people-label {
  color: #9ca3af;
}
.order-footer {
  padding-top: 12rpx;
  border-top: 1rpx solid #f9fafb;
}
.order-time {
  font-size: 22rpx;
  color: #9ca3af;
}
.order-commission {
  font-size: 22rpx;
  color: #f59e0b;
}
