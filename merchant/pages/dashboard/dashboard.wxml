<wxs src="../../utils/util.wxs" module="util" />

<view class="page-dashboard">
  <!-- 顶部标题栏 -->
  <view class="header">
    <view class="header-title">校园便利圈 · 商家端</view>
    <view class="header-date">{{util.formatDate('')}}</view>
  </view>

  <!-- KPI 指标卡片 -->
  <view class="kpi-grid">
    <view class="kpi-card kpi-revenue" bindtap="goToFinance">
      <view class="kpi-label">总交易额</view>
      <view class="kpi-value">{{util.formatAmount(kpis.totalRevenue)}}</view>
      <view class="kpi-sub">平台抽成 {{util.formatAmount(kpis.platformCommission)}}</view>
    </view>
    <view class="kpi-card kpi-orders" bindtap="goToOrders">
      <view class="kpi-label">总订单数</view>
      <view class="kpi-value">{{kpis.totalOrders}}</view>
      <view class="kpi-sub">今日 +{{kpis.todayOrders}} · 已完成 {{kpis.completedOrders}}</view>
    </view>
    <view class="kpi-card kpi-users" bindtap="goToUsers">
      <view class="kpi-label">用户总数</view>
      <view class="kpi-value">{{kpis.userCount}}</view>
      <view class="kpi-sub">注册用户</view>
    </view>
    <view class="kpi-card kpi-withdraw" bindtap="goToWithdraws">
      <view class="kpi-label">待处理提现</view>
      <view class="kpi-value">{{util.formatAmount(kpis.pendingWithdrawAmount)}}</view>
      <view class="kpi-sub">{{kpis.pendingWithdraws}} 笔待审核</view>
    </view>
  </view>

  <!-- 分类统计 -->
  <view class="card">
    <view class="card-title">分类统计</view>
    <view class="category-list">
      <view class="category-item"
        wx:for="{{categories}}" wx:key="key"
        bindtap="goToOrders" data-type="{{item.key}}"
      >
        <view class="cat-icon">{{item.icon}}</view>
        <view class="cat-info">
          <view class="cat-name">{{item.name}}</view>
          <view class="cat-count">{{item.count}} 笔订单</view>
        </view>
        <view class="cat-amount">{{util.formatAmount(item.amount)}}</view>
      </view>
    </view>
  </view>

  <!-- 近14天趋势 -->
  <view class="card" wx:if="{{chartData && chartData.length > 0}}">
    <view class="card-title">近14天交易趋势</view>
    <view class="chart-container">
      <view class="chart-bars">
        <view class="bar-wrapper" wx:for="{{chartData}}" wx:key="date">
          <view class="bar-value" wx:if="{{item.amount > 0}}">{{util.formatAmount(item.amount)}}</view>
          <view class="bar" style="height: {{item.height}}%"></view>
          <view class="bar-label">{{item.date}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 最近交易 -->
  <view class="card">
    <view class="card-title flex-between">
      <text>最近交易</text>
      <text class="card-more" bindtap="goToOrders">查看全部 ›</text>
    </view>
    <view wx:if="{{recentTransactions.length === 0}}" class="empty-state">
      <text class="icon">📋</text>
      <text>暂无交易记录</text>
    </view>
    <view class="tx-list" wx:else>
      <view class="tx-item" wx:for="{{recentTransactions}}" wx:key="id">
        <view class="tx-left">
          <view class="tx-type">{{util.getOrderTypeName(item.type)}}</view>
          <view class="tx-people">{{item.buyer}} → {{item.seller}}</view>
        </view>
        <view class="tx-right">
          <view class="tx-amount">{{util.formatAmount(item.amount)}}</view>
          <view class="tx-status tag {{item.status === 'confirmed' ? 'tag-success' : 'tag-info'}}">
            {{util.getPaymentStatusName(item.status)}}
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
