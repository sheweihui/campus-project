<view class="tab-bar">
  <view class="tab-bar-inner">
    <view
      class="tab-item {{selected === index ? 'active' : ''}}"
      wx:for="{{list}}" wx:key="index"
      data-path="{{item.pagePath}}" data-index="{{index}}"
      bindtap="switchTab"
    >
      <view class="tab-icon-wrap">
        <image class="tab-icon" src="{{selected === index ? item.selectedIcon : item.icon}}" mode="aspectFit" />
        <view class="tab-badge" wx:if="{{index === 2 && unreadCount > 0}}">{{unreadCount > 99 ? '99+' : unreadCount}}</view>
      </view>
      <text class="tab-text">{{item.text}}</text>
    </view>
  </view>
</view>
