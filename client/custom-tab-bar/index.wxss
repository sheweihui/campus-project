.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
}

.tab-bar-inner {
  display: flex;
  align-items: center;
  padding: 12rpx 12rpx calc(12rpx + env(safe-area-inset-bottom));
  border-radius: 0;
  background: linear-gradient(180deg, #fff0f5 0%, #ffffff 100%);
  border: 2rpx solid rgba(255, 170, 195, 0.35);
  box-shadow: 0 -4rpx 16rpx rgba(255, 150, 185, 0.1);
  box-sizing: border-box;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
  border-radius: 24rpx;
}

.tab-item.active {
  background: rgba(255, 255, 255, 0.75);
}

.tab-icon {
  width: 52rpx;
  height: 52rpx;
}

.tab-text {
  font-size: 22rpx;
  color: #999999;
  margin-top: 6rpx;
}

.tab-item.active .tab-text {
  color: #ff5c8a;
  font-weight: 600;
}
