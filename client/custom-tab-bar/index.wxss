.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
}

.tab-bar-inner {
  display: flex;
  align-items: center;
  padding: 12rpx 12rpx calc(12rpx + env(safe-area-inset-bottom));
  border-radius: 0;
  background: linear-gradient(180deg, #eef4ff 0%, #ffffff 100%);
  border: 2rpx solid rgba(140, 170, 230, 0.4);
  box-shadow: 0 -4rpx 16rpx rgba(100, 140, 220, 0.12);
  box-sizing: border-box;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
  border-radius: 24rpx;
}

.tab-item.active {
  background: rgba(255, 255, 255, 0.8);
}

.tab-icon {
  width: 52rpx;
  height: 52rpx;
}

.tab-text {
  font-size: 22rpx;
  color: #999999;
  margin-top: 6rpx;
}

.tab-item.active .tab-text {
  color: #2f6fed;
  font-weight: 600;
}
