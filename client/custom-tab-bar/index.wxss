.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
}

.tab-bar-inner {
  display: flex;
  align-items: center;
  padding: 12rpx 12rpx calc(12rpx + env(safe-area-inset-bottom));
  border-radius: 0;
  background: #faf8f3;
  border: 3rpx solid #1a1a1a;
  box-shadow: 0 -6rpx 0 rgba(26, 26, 26, 0.1);
  box-sizing: border-box;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
  border-radius: 24rpx;
}

.tab-item.active {
  background: #ffe66d;
  border: 2rpx solid #1a1a1a;
  border-radius: 16rpx;
}

.tab-icon {
  width: 52rpx;
  height: 52rpx;
}

.tab-text {
  font-size: 22rpx;
  color: #666666;
  margin-top: 6rpx;
}

.tab-item.active .tab-text {
  color: #1a1a1a;
  font-weight: 800;
}
