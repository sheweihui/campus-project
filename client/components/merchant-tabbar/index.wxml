<view class="mt-bar">
  <view class="mt-inner">
    <view
      class="mt-item {{selected === index ? 'active' : ''}}"
      wx:for="{{list}}" wx:key="pagePath"
      data-path="{{item.pagePath}}" data-index="{{index}}"
      bindtap="switchTab"
    >
      <text class="mt-icon">{{item.icon}}</text>
      <text class="mt-text">{{item.text}}</text>
    </view>
  </view>
</view>