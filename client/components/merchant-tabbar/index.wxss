.mt-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
}

.mt-inner {
  display: flex;
  align-items: center;
  padding: 12rpx 12rpx calc(12rpx + env(safe-area-inset-bottom));
  background: #faf8f3;
  border-top: 3rpx solid #1a1a1a;
  box-shadow: 0 -6rpx 0 rgba(26, 26, 26, 0.08);
  box-sizing: border-box;
}

.mt-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0;
  border-radius: 16rpx;
}

.mt-item.active {
  background: #ffe66d;
  border: 2rpx solid #1a1a1a;
}

.mt-icon {
  font-size: 36rpx;
  line-height: 1;
}

.mt-text {
  font-size: 22rpx;
  color: #666666;
  margin-top: 6rpx;
}

.mt-item.active .mt-text {
  color: #1a1a1a;
  font-weight: 800;
}