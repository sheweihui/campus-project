@import "utils/weui.wxss";

/* 全局样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
  background: #faf8f3;
  color: #333333;
}

/* 通用容器 */
.container {
  padding: 20rpx;
}

/* 卡片样式 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #f0f1f3;
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0) 45%), rgba(51, 51, 51, 0.7);
  -webkit-backdrop-filter: blur(24rpx);
  backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}
.btn-primary:active {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0) 45%), rgba(0, 0, 0, 0.82);
}

.btn-secondary {
  background: #f4f4f5;
  color: #666666;
  border-radius: 12rpx;
  font-size: 32rpx;
}

/* 表单样式 */
.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}

.form-input:focus {
  border-color: #333333;
  background: #fff;
}

.form-textarea {
  width: 100%;
  height: 200rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}

.form-textarea:focus {
  border-color: #333333;
  background: #fff;
}

/* 列表样式 */
.list-item {
  background: #fff;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
}

.list-item:last-child {
  border-bottom: none;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 10rpx;
}

.tag-primary {
  background: #f0f0f0;
  color: #444444;
}

.tag-warning {
  background: #fff7e6;
  color: #b25e00;
}

.tag-danger {
  background: #fdecea;
  color: #d4380d;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #9ca3af;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx;
  font-size: 26rpx;
  color: #999;
}

/* 浮动按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #4CAF50, #45a049);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(76, 175, 80, 0.4);
  z-index: 999;
}

.fab-icon {
  color: #fff;
  font-size: 48rpx;
  font-weight: bold;
}

/* 网格布局 */
.grid {
  display: flex;
  flex-wrap: wrap;
}

.grid-item {
  width: 25%;
  text-align: center;
  padding: 30rpx 0;
}

.grid-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 10rpx;
}

.grid-text {
  font-size: 26rpx;
  color: #666;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx 30rpx;
  border-radius: 16rpx;
  margin: 20rpx;
  border: 1rpx solid #ececec;
}

.search-input {
  flex: 1;
  margin-left: 20rpx;
  font-size: 28rpx;
}

/* 图片上传 */
.upload-box {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f8f8f8;
}

.upload-icon {
  font-size: 48rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.upload-text {
  font-size: 24rpx;
  color: #999;
}

/* ===== 商家端全局样式（合并自 merchant/app.wxss） ===== */
page {
  --primary: #4a6cf7;
  --primary-light: #eef1ff;
  --success: #10b981;
  --warning: #f59e0b;
  --danger: #ef4444;
  --bg: #faf8f3;
  --card-bg: #ffffff;
  --text: #1a1a2e;
  --text-secondary: #6b7280;
  --text-muted: #9ca3af;
  --border: #e5e7eb;
  --radius: 12rpx;
  --shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);

  background-color: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  box-sizing: border-box;
}

.btn-outline {
  background: #fff;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: var(--radius);
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  text-align: center;
  display: inline-block;
}

.btn-danger {
  background: var(--danger);
  color: #fff;
  border: none;
  border-radius: var(--radius);
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  text-align: center;
}

.btn-sm {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
}

.divider {
  height: 1rpx;
  background: var(--border);
  margin: 24rpx 0;
}

.tag-success { background: #dbf1e1; color: #18b566; }
.tag-warning { background: #fdf6ec; color: #f29100; }
.tag-danger { background: #fef0f0; color: #fa3534; }
.tag-info { background: #ecf5ff; color: #2979ff; }
.tag-default { background: #f4f4f5; color: #909399; }

.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-wrap { flex-wrap: wrap; }
.flex-center { align-items: center; justify-content: center; }
.flex-between { align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; }

/* ===== WeUI 品牌色覆盖 ===== */
.weui-btn_primary {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0) 45%), rgba(51, 51, 51, 0.7);
  -webkit-backdrop-filter: blur(24rpx);
  backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}
.weui-btn {
  border-radius: 12rpx;
  font-weight: 600;
  margin-top: 16rpx;
}
.weui-btn_primary:not(.weui-btn_disabled):active {
  color: rgba(255, 255, 255, 0.85);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0) 45%), rgba(0, 0, 0, 0.82);
}
.weui-btn_default {
  color: #666666;
}
.weui-cells {
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid #f0f1f3;
}
.weui-cells::before,
.weui-cells::after,
.weui-cell::before {
  border-color: #e4e7ed;
}
.weui-panel {
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid #f0f1f3;
}
.weui-search-bar {
  border-radius: 16rpx;
  overflow: hidden;
}

/* ===== 通用列表单元格（WeUI cells 风格） ===== */
.list-thumb {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-right: 24rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}
.list-thumb image {
  width: 100%;
  height: 100%;
}
.list-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.list-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.list-desc {
  display: block;
  font-size: 22rpx;
  color: #999999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.list-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999999;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.list-price {
  color: #e64340;
  font-weight: 700;
  font-size: 28rpx;
}
.list-status {
  font-size: 22rpx;
  color: #999999;
}
.list-status.active,
.list-status.pending,
.list-status.accepted {
  color: #f5a623;
}
.list-status.paid {
  color: #1d6fe0;
}
.list-status.completed {
  color: #1a7f37;
}
.weui-cell {
  padding: 24rpx;
}
.weui-cell__hd {
  margin-right: 20rpx;
}

/* ===== 全局漫画风覆盖（高优先级，作用于所有页面） ===== */
page .card,
page .weui-cells {
  border: 3rpx solid #1a1a1a;
  border-radius: 20rpx;
  box-shadow: 6rpx 6rpx 0 rgba(26, 26, 26, 0.12);
}

page .btn-primary,
page .weui-btn_primary {
  background: #1a1a1a;
  color: #ffffff;
  border: none;
  border-radius: 16rpx;
  box-shadow: 6rpx 6rpx 0 #ffe66d;
}

page .btn-primary:active,
page .weui-btn_primary:active {
  box-shadow: 2rpx 2rpx 0 #ffe66d;
  transform: translate(4rpx, 4rpx);
}

page .btn-secondary,
page .weui-btn_default {
  background: #ffffff;
  color: #1a1a1a;
  border: 3rpx solid #1a1a1a;
  border-radius: 16rpx;
  box-shadow: 4rpx 4rpx 0 rgba(26, 26, 26, 0.18);
}

page .tag {
  border: 2rpx solid #1a1a1a;
}

page .search-bar {
  background: #ffffff;
  border: 3rpx solid #1a1a1a;
  border-radius: 16rpx;
  box-shadow: 4rpx 4rpx 0 rgba(26, 26, 26, 0.12);
}

page .list-thumb {
  border: 2rpx solid #1a1a1a;
  background: #fff6e5;
}

page .form-input,
page .form-textarea {
  background: #ffffff;
  border: 2rpx solid #1a1a1a;
  border-radius: 12rpx;
}

page .form-input:focus,
page .form-textarea:focus {
  border-color: #1a1a1a;
  background: #ffffff;
}

page .kpi-card {
  border: 3rpx solid #1a1a1a;
  border-radius: 16rpx;
  box-shadow: 4rpx 4rpx 0 rgba(26, 26, 26, 0.12);
}

page .search-btn,
page .add-btn,
page .submit-btn,
page .action-btn.edit,
page .bar-btn.primary {
  background: #1a1a1a;
  color: #ffffff;
  border: none;
  border-radius: 12rpx;
  box-shadow: 4rpx 4rpx 0 #ffe66d;
}

page .search-btn:active,
page .add-btn:active,
page .submit-btn:active,
page .action-btn.edit:active,
page .bar-btn.primary:active {
  box-shadow: 1rpx 1rpx 0 #ffe66d;
  transform: translate(3rpx, 3rpx);
}
