<view class="container">
  <view class="card" wx:if="{{detail}}">
    <!-- 拼车详情 -->
    <block wx:if="{{detail.type === 'carpool'}}">
      <view class="detail-header">
        <text class="detail-type">🚗 拼车出行</text>
        <text class="status {{detail.status}}">{{detail.status === 'active' ? '进行中' : '已完成'}}</text>
      </view>
      <view class="route-section">
        <view class="route-item">
          <text class="route-label">出发地</text>
          <text class="route-value">{{detail.from}}</text>
        </view>
        <view class="route-arrow">↓</view>
        <view class="route-item">
          <text class="route-label">目的地</text>
          <text class="route-value">{{detail.to}}</text>
        </view>
      </view>
      <view class="detail-section">
        <view class="section-label">出发时间</view>
        <view class="section-value">🕐 {{detail.date || detail.time}} {{detail.timeSlot || ''}}</view>
      </view>
      <view class="detail-section">
        <view class="section-label">人数</view>
        <view class="section-value">👥 {{detail.people}} 人</view>
      </view>
      <view class="detail-section" wx:if="{{detail.remark}}">
        <view class="section-label">备注</view>
        <view class="section-value">{{detail.remark}}</view>
      </view>
      <!-- 联系方式：搭子类型对所有人可见，方便联系 -->
      <view class="detail-section">
        <view class="section-label">联系方式</view>
        <view class="section-value contact" bindtap="copyContact">{{detail.contact}}</view>
      </view>
    </block>

    <!-- 代取快递详情 -->
    <block wx:if="{{detail.type === 'express'}}">
      <view class="detail-header">
        <text class="detail-type">📦 代取快递</text>
        <text class="status {{detail.status}}">{{expressStatusMap[detail.status]}}</text>
      </view>
      <view class="detail-section">
        <view class="section-label">取件地点</view>
        <view class="section-value">📍 {{detail.pickupLocation}}</view>
      </view>
      <!-- 取件码：发布者和接单者可见，普通浏览者隐藏 -->
      <view class="detail-section">
        <view class="section-label">取件码</view>
        <view class="section-value highlight" wx:if="{{isOwner || isAcceptor}}">{{detail.pickupCode}}</view>
        <view class="section-value hidden" wx:else>***</view>
      </view>
      <view class="detail-section">
        <view class="section-label">收件人</view>
        <view class="section-value">👤 {{detail.recipient}}</view>
      </view>
      <view class="detail-section">
        <view class="section-label">收件地址</view>
        <view class="section-value">📍 {{detail.address}}</view>
      </view>
      <view class="detail-section">
        <view class="section-label">酬金</view>
        <view class="section-value reward">💰 ¥{{detail.reward}}</view>
      </view>
      <view class="detail-section">
        <view class="section-label">截止时间</view>
        <view class="section-value">⏰ {{detail.deadline}}</view>
      </view>
      <view class="detail-section" wx:if="{{detail.remark}}">
        <view class="section-label">备注</view>
        <view class="section-value">{{detail.remark}}</view>
      </view>
      <!-- 联系方式：发布者和接单者可见，普通浏览者隐藏 -->
      <view class="detail-section" wx:if="{{isOwner || isAcceptor}}">
        <view class="section-label">联系方式</view>
        <view class="section-value contact" bindtap="copyContact">{{detail.contact}}</view>
      </view>
      <view class="detail-section" wx:else>
        <view class="section-label">联系方式</view>
        <view class="section-value hidden">请接单后查看</view>
      </view>
    </block>

    <!-- 找搭子详情 -->
    <block wx:if="{{detail.type === 'partner'}}">
      <view class="detail-header">
        <text class="detail-type">👥 找搭子</text>
        <text class="status {{detail.status}}">{{detail.status === 'active' ? '进行中' : '已完成'}}</text>
      </view>
      <view class="detail-section">
        <view class="section-label">搭子类型</view>
        <view class="section-value">{{partnerTypeMap[detail.partnerType]}}</view>
      </view>
      <view class="detail-section">
        <view class="section-label">时间</view>
        <view class="section-value">🕐 {{detail.date || detail.time}} {{detail.timeSlot || ''}}</view>
      </view>
      <view class="detail-section">
        <view class="section-label">地点</view>
        <view class="section-value">📍 {{detail.location}}</view>
      </view>
      <view class="detail-section">
        <view class="section-label">需要人数</view>
        <view class="section-value">👥 {{detail.people}} 人</view>
      </view>
      <view class="detail-section" wx:if="{{detail.description}}">
        <view class="section-label">详细描述</view>
        <view class="section-value">{{detail.description}}</view>
      </view>
      <!-- 联系方式：搭子类型对所有人可见，方便联系 -->
      <view class="detail-section">
        <view class="section-label">联系方式</view>
        <view class="section-value contact" bindtap="copyContact">{{detail.contact}}</view>
      </view>
    </block>

    <!-- 其他互助详情 -->
    <block wx:if="{{detail.type === 'other'}}">
      <view class="detail-header">
        <text class="detail-type">📝 其他互助</text>
        <text class="status {{detail.status}}">{{expressStatusMap[detail.status]}}</text>
      </view>
      <view class="detail-section">
        <view class="section-label">标题</view>
        <view class="section-value">{{detail.title}}</view>
      </view>
      <view class="detail-section">
        <view class="section-label">时间</view>
        <view class="section-value">🕐 {{detail.date || detail.time}} {{detail.timeSlot || ''}}</view>
      </view>
      <view class="detail-section">
        <view class="section-label">地点</view>
        <view class="section-value">📍 {{detail.location}}</view>
      </view>
      <view class="detail-section">
        <view class="section-label">酬金</view>
        <view class="section-value reward">💰 ¥{{detail.reward}}</view>
      </view>
      <view class="detail-section" wx:if="{{detail.description}}">
        <view class="section-label">详细描述</view>
        <view class="section-value">{{detail.description}}</view>
      </view>
      <!-- 联系方式：发布者和接单者可见，普通浏览者待接单时隐藏 -->
      <view class="detail-section" wx:if="{{isOwner || isAcceptor}}">
        <view class="section-label">联系方式</view>
        <view class="section-value contact" bindtap="copyContact">{{detail.contact}}</view>
      </view>
      <view class="detail-section" wx:if="{{isVisitor && detail.status === 'pending'}}">
        <view class="section-label">联系方式</view>
        <view class="section-value hidden">请接单后查看</view>
      </view>
      <view class="detail-section" wx:if="{{isVisitor && detail.status !== 'pending'}}">
        <view class="section-label">联系方式</view>
        <view class="section-value contact" bindtap="copyContact">{{detail.contact}}</view>
      </view>
    </block>

    <view class="detail-time">发布于 {{createTime}}</view>
  </view>
</view>

<!-- 发布者操作栏 -->
<view class="bottom-bar" wx:if="{{isOwner && detail.type !== 'express' && detail.type !== 'other'}}">
  <view class="bar-btn {{detail.status !== 'active' ? 'disabled' : ''}}" bindtap="updateStatus">
    {{detail.status === 'active' ? '标记为已完成' : '已完成'}}
  </view>
  <view class="bar-btn" bindtap="editItem">编辑</view>
  <view class="bar-btn" bindtap="startChat">聊天</view>
  <view class="bar-btn delete" bindtap="deleteItem">删除</view>
</view>

<!-- 发布者操作栏（快递/其他互助） -->
<view class="bottom-bar" wx:if="{{isOwner && (detail.type === 'express' || detail.type === 'other')}}">
  <view class="bar-btn primary {{detail.status !== 'accepted' ? 'disabled' : ''}}" bindtap="payNow">支付酬金</view>
  <view class="bar-btn" bindtap="startChat">聊天</view>
  <view class="bar-btn {{detail.status === 'completed' ? 'disabled' : ''}}" bindtap="updateStatus">
    {{detail.status === 'completed' ? '已完成' : '标记已完成'}}
  </view>
</view>

<!-- 接单者操作栏（快递/其他互助） -->
<view class="bottom-bar" wx:if="{{isAcceptor && (detail.type === 'express' || detail.type === 'other')}}">
  <view class="bar-btn primary {{detail.status === 'accepted' ? 'disabled' : ''}}" bindtap="acceptExpress">接单</view>
  <view class="bar-btn" bindtap="startChat">聊天</view>
  <view class="bar-btn" bindtap="copyContact">复制联系方式</view>
</view>

<!-- 普通浏览者操作栏 -->
<view class="bottom-bar" wx:if="{{isVisitor}}">
  <view class="bar-btn primary" wx:if="{{detail.type === 'express' && detail.status === 'pending'}}" bindtap="acceptExpress">接单</view>
  <view class="bar-btn primary" wx:if="{{detail.type === 'other' && (detail.status === 'pending' || detail.status === 'active')}}" bindtap="acceptExpress">接单</view>
  <view class="bar-btn primary" wx:if="{{detail.type === 'carpool' || detail.type === 'partner'}}" bindtap="startChat">💬 在线聊天</view>
  <view class="bar-btn" bindtap="copyContact" wx:if="{{detail.type === 'carpool' || detail.type === 'partner'}}">📋 复制号码</view>
</view>