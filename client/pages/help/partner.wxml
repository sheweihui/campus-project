<view class="container">
  <!-- 列表 -->
  <view class="list">
    <view class="list-item" wx:for="{{list}}" wx:key="_id" bindtap="goToDetail" data-id="{{item._id}}">
      <view class="item-icon">👥</view>
      <view class="item-content">
        <view class="item-type">{{partnerTypeMap[item.partnerType]}}</view>
        <view class="item-info">
          <text>🕐 {{item.time}}</text>
          <text>📍 {{item.location}}</text>
        </view>
        <view class="item-people">👥 需要 {{item.people}} 人</view>
        <view class="item-desc" wx:if="{{item.description}}">{{item.description}}</view>
      </view>
      <view class="item-status {{item.status}}">{{item.status === 'active' ? '进行中' : '已完成'}}</view>
    </view>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{!isLoading && hasMore}}">上拉加载更多</view>
  <view class="load-more" wx:if="{{!isLoading && !hasMore && list.length > 0}}">没有更多了</view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!isLoading && list.length === 0}}">
    <text class="empty-text">暂无搭子信息</text>
  </view>
</view>

<!-- 发布按钮 -->
<view class="fab" bindtap="goToPublish">
  <text class="fab-icon">+</text>
</view>