.list {
  background: #fff;
  border-radius: 16rpx;
  padding: 0 20rpx;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.list-item:last-child {
  border-bottom: none;
}

.item-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #FF9800, #F57C00);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
}

.item-content {
  flex: 1;
}

.item-code {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.item-info {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.item-info text {
  display: block;
  margin-bottom: 5rpx;
}

.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-reward {
  font-size: 28rpx;
  color: #f44336;
  font-weight: bold;
}

.item-deadline {
  font-size: 24rpx;
  color: #999;
}

.item-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.item-status.pending {
  background: #fff3e0;
  color: #ff9800;
}

.item-status.accepted {
  background: #e3f2fd;
  color: #2196F3;
}

.item-status.completed {
  background: #f5f5f5;
  color: #999;
}