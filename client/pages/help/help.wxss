.grid {
  display: flex;
  flex-wrap: wrap;
}

.grid-item {
  width: 25%;
  text-align: center;
  padding: 30rpx 0;
}

.grid-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin: 0 auto 12rpx;
}

.grid-icon.carpool {
  background: #2979ff;
}

.grid-icon.express {
  background: #ff9900;
}

.grid-icon.partner {
  background: #909399;
}

.grid-icon.other {
  background: #19be6b;
}

.grid-text {
  font-size: 26rpx;
  color: #666;
}

.list {
  margin-top: 20rpx;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.list-item:last-child {
  border-bottom: none;
}

.item-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
}

.item-icon.carpool {
  background: linear-gradient(135deg, #2196F3, #1976D2);
}

.item-icon.express {
  background: linear-gradient(135deg, #FF9800, #F57C00);
}

.item-icon.partner {
  background: linear-gradient(135deg, #9C27B0, #7B1FA2);
}

.item-icon.other {
  background: linear-gradient(135deg, #00BCD4, #0097A7);
}

.item-content {
  flex: 1;
}

.item-route {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-info {
  font-size: 26rpx;
  color: #666;
}

.item-info text {
  margin-right: 20rpx;
}

.item-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.item-status.active {
  background: #e8f5e9;
  color: #4CAF50;
}

.item-status.completed {
  background: #f5f5f5;
  color: #999;
}

.item-status.pending {
  background: #fff3e0;
  color: #ff9800;
}

.item-status.accepted {
  background: #e3f2fd;
  color: #2196F3;
}
