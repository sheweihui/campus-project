.container {
  position: relative;
  min-height: 100vh;
  background: linear-gradient(180deg, #0b1026 0%, #1b2a5e 100%);
  padding: 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
}

/* 炫彩流星背景 */
.meteor-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  z-index: 0;
}

.star {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #fff;
  opacity: 0.7;
  animation: twinkle 2.4s ease-in-out infinite;
}

.s1 { top: 12%; left: 8%; animation-delay: 0s; }
.s2 { top: 22%; left: 30%; animation-delay: 0.5s; }
.s3 { top: 10%; left: 55%; animation-delay: 1s; }
.s4 { top: 28%; left: 78%; animation-delay: 0.2s; }
.s5 { top: 40%; left: 18%; animation-delay: 1.4s; }
.s6 { top: 55%; left: 62%; animation-delay: 0.8s; }
.s7 { top: 68%; left: 38%; animation-delay: 1.8s; }
.s8 { top: 78%; left: 85%; animation-delay: 0.4s; }
.s9 { top: 85%; left: 12%; animation-delay: 1.2s; }
.s10 { top: 48%; left: 90%; animation-delay: 2s; }

@keyframes twinkle {
  0%, 100% { opacity: 0.2; }
  50% { opacity: 0.9; }
}

.meteor {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #fff;
  opacity: 0;
  box-shadow: 0 0 14rpx rgba(255, 255, 255, 0.85);
  animation: meteor-fall 3.4s linear infinite;
}

.meteor::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 260rpx;
  height: 3rpx;
  transform-origin: left center;
  transform: rotate(-38deg);
}

.m1 { top: 8%; left: 20%; animation-duration: 2.8s; animation-delay: 0s; }
.m2 { top: 20%; left: 60%; animation-duration: 3.6s; animation-delay: 1.2s; }
.m3 { top: 35%; left: 38%; animation-duration: 3.1s; animation-delay: 2.3s; }
.m4 { top: 12%; left: 82%; animation-duration: 3.9s; animation-delay: 0.7s; }
.m5 { top: 48%; left: 70%; animation-duration: 3.4s; animation-delay: 1.9s; }
.m6 { top: 28%; left: 8%; animation-duration: 2.5s; animation-delay: 2.8s; }
.m7 { top: 60%; left: 30%; animation-duration: 4.1s; animation-delay: 0.4s; }
.m8 { top: 70%; left: 75%; animation-duration: 3.2s; animation-delay: 1.6s; }

.m1::after { background: linear-gradient(90deg, rgba(255, 107, 157, 0.95) 0%, rgba(255, 107, 157, 0) 100%); }
.m2::after { background: linear-gradient(90deg, rgba(122, 162, 255, 0.95) 0%, rgba(122, 162, 255, 0) 100%); }
.m3::after { background: linear-gradient(90deg, rgba(157, 123, 255, 0.95) 0%, rgba(157, 123, 255, 0) 100%); }
.m4::after { background: linear-gradient(90deg, rgba(95, 242, 194, 0.95) 0%, rgba(95, 242, 194, 0) 100%); }
.m5::after { background: linear-gradient(90deg, rgba(255, 209, 102, 0.95) 0%, rgba(255, 209, 102, 0) 100%); }
.m6::after { background: linear-gradient(90deg, rgba(110, 231, 255, 0.95) 0%, rgba(110, 231, 255, 0) 100%); }
.m7::after { background: linear-gradient(90deg, rgba(255, 145, 200, 0.95) 0%, rgba(255, 145, 200, 0) 100%); }
.m8::after { background: linear-gradient(90deg, rgba(130, 255, 170, 0.95) 0%, rgba(130, 255, 170, 0) 100%); }

@keyframes meteor-fall {
  0% {
    transform: translate3d(0, 0, 0);
    opacity: 0;
  }
  4% { opacity: 1; }
  22% { opacity: 1; }
  45% {
    opacity: 0;
    transform: translate3d(-280rpx, 340rpx, 0);
  }
  100% {
    opacity: 0;
    transform: translate3d(-280rpx, 340rpx, 0);
  }
}

/* Logo区域 */
.logo-section {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  padding-top: 60rpx;
}

.logo {
  width: 180rpx;
  height: 180rpx;
  background: rgba(255, 255, 255, 0.14);
  -webkit-backdrop-filter: blur(24rpx);
  backdrop-filter: blur(24rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 90rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.25);
}

.app-name {
  font-size: 52rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.35);
}

.subtitle {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 磨砂玻璃登录卡片 */
.form-section {
  position: relative;
  z-index: 1;
  background: rgba(255, 255, 255, 0.14);
  -webkit-backdrop-filter: blur(40rpx);
  backdrop-filter: blur(40rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 32rpx;
  padding: 60rpx 48rpx;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.35);
  min-height: 640rpx;
}

.wx-login {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wx-tips {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 20rpx;
  text-align: center;
}

.divider {
  display: flex;
  align-items: center;
  margin: 44rpx 0 32rpx;
}

.divider-line {
  flex: 1;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.25);
}

.divider-text {
  padding: 0 30rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
}

/* 按钮：玻璃质感覆盖 */
.form-section .weui-btn {
  width: 100%;
  margin-top: 8rpx;
}

.form-section .weui-btn_primary {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.18) 0%, rgba(255, 255, 255, 0) 45%), rgba(255, 255, 255, 0.18);
  -webkit-backdrop-filter: blur(24rpx);
  backdrop-filter: blur(24rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25);
}

.form-section .weui-btn_default {
  background: rgba(255, 255, 255, 0.14);
  -webkit-backdrop-filter: blur(24rpx);
  backdrop-filter: blur(24rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  color: #fff;
}
