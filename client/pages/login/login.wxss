.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* Logo区域样式 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  padding-top: 60rpx;
}

.logo {
  width: 180rpx;
  height: 180rpx;
  background: #fff;
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 90rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.2);
}

.app-name {
  font-size: 52rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
  text-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}

.subtitle {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 表单区域样式 */
.form-section {
  background: #fff;
  border-radius: 32rpx;
  padding: 60rpx 48rpx;
  box-shadow: 0 25rpx 80rpx rgba(0, 0, 0, 0.2);
  min-height: 720rpx;
}

/* 输入框组样式 */
.input-group {
  margin-bottom: 52rpx;
}

.input-label {
  font-size: 32rpx;
  color: #2d2d2d;
  font-weight: 600;
  margin-bottom: 20rpx;
  display: block;
}

.input-field {
  width: 100%;
  height: 100rpx;
  background: #f8f9fa;
  border-radius: 20rpx;
  padding: 0 32rpx;
  font-size: 32rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.input-field:focus {
  border-color: #667eea;
  background: #fff;
}

/* 登录按钮样式 */
.login-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 50rpx;
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  transition: transform 0.2s, box-shadow 0.2s;
}

.login-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.login-btn[loading] {
  opacity: 0.8;
}

/* 提示信息样式 */
.tips {
  margin-top: 50rpx;
  text-align: center;
}

.tip-text {
  font-size: 26rpx;
  color: #999;
  line-height: 1.6;
}

/* 分割线样式 */
.divider {
  display: flex;
  align-items: center;
  margin: 40rpx 0;
}

.divider-line {
  flex: 1;
  height: 2rpx;
  background: #e0e0e0;
}

.divider-text {
  padding: 0 30rpx;
  font-size: 24rpx;
  color: #999;
}