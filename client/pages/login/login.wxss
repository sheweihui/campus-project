.container {
  min-height: 100vh;
  background: transparent;
  padding: 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* Logo区域样式 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  padding-top: 60rpx;
}

.logo {
  width: 180rpx;
  height: 180rpx;
  background: #ffffff;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 90rpx;
  margin-bottom: 40rpx;
  border: 1rpx solid #f0f1f3;
  box-shadow: none;
}

.app-name {
  font-size: 52rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
  text-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}

.subtitle {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 表单区域样式 */
.form-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 48rpx;
  border: 1rpx solid #f0f1f3;
  min-height: 720rpx;
}

/* 输入框组样式 */
.input-group {
  margin-bottom: 52rpx;
}

.input-label {
  font-size: 32rpx;
  color: #2d2d2d;
  font-weight: 600;
  margin-bottom: 20rpx;
  display: block;
}

.input-field {
  width: 100%;
  height: 100rpx;
  background: #f8f9fa;
  border-radius: 20rpx;
  padding: 0 32rpx;
  font-size: 32rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.input-field:focus {
  border-color: #333333;
  background: #fff;
}

/* 登录按钮样式 */
.login-btn {
  width: 100%;
  height: 100rpx;
  background: #333333;
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 50rpx;
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  transition: transform 0.2s, box-shadow 0.2s;
}

.login-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.login-btn[loading] {
  opacity: 0.8;
}

/* 微信一键登录 */
.wx-login {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wx-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0) 45%), rgba(51, 51, 51, 0.7);
  -webkit-backdrop-filter: blur(24rpx);
  backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  transition: transform 0.2s;
  border: none;
}

.wx-btn:active {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0) 45%), rgba(0, 0, 0, 0.82);
}

.wx-btn:active {
  transform: scale(0.98);
}

.wx-tips {
  font-size: 24rpx;
  color: #999;
  margin-top: 20rpx;
  text-align: center;
}

/* 游客登录按钮样式 */
.guest-btn {
  width: 100%;
  height: 90rpx;
  background: #fff;
  color: #666666;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  margin-top: 10rpx;
  border: 2rpx solid #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s;
  background: rgba(255, 255, 255, 0.96);
}

.guest-btn:active {
  transform: scale(0.98);
}

/* 提示信息样式 */
.tips {
  margin-top: 50rpx;
  text-align: center;
}

.tip-text {
  font-size: 26rpx;
  color: #999;
  line-height: 1.6;
}

/* 分割线样式 */
.divider {
  display: flex;
  align-items: center;
  margin: 40rpx 0;
}

.divider-line {
  flex: 1;
  height: 2rpx;
  background: #e0e0e0;
}

.divider-text {
  padding: 0 30rpx;
  font-size: 24rpx;
  color: #999;
}

/* ===== Step 2: 完善资料 ===== */

/* 头像选择区 */
.profile-avatar-section {
  display: flex;
  justify-content: center;
  margin-bottom: 48rpx;
}

.profile-avatar-btn {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  padding: 0;
  border: 6rpx solid #e8e8e8;
  overflow: hidden;
  background: transparent;
  line-height: 1;
}

.profile-avatar-btn::after {
  border: none;
}

.profile-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.profile-avatar-placeholder {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #f5f7fa;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.profile-avatar-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.profile-avatar-tip {
  font-size: 20rpx;
  color: #999;
}

/* 输入框组 */
.profile-input-group {
  margin-bottom: 36rpx;
}

.profile-input-label {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.profile-input {
  width: 100%;
  height: 90rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.profile-input:focus {
  border-color: #333333;
  background: #fff;
}

/* 手机号只读展示 */
.profile-phone-display {
  width: 100%;
  height: 90rpx;
  background: #f0f0f0;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #666;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

/* 提交按钮 */
.profile-submit-btn {
  width: 100%;
  height: 100rpx;
  background: #333333;
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 50rpx;
  margin-top: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
}

.profile-submit-btn:active {
  transform: scale(0.98);
}

.profile-submit-btn[disabled] {
  opacity: 0.7;
}

/* 跳过 */
.profile-skip {
  text-align: center;
  margin-top: 32rpx;
  font-size: 26rpx;
  color: #999;
  padding: 20rpx;
}

/* 返回上一步 */
.back-section {
  text-align: center;
  margin-top: 30rpx;
}

.back-btn {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  padding: 16rpx 32rpx;
}

.required {
  color: #e74c3c;
  margin-left: 4rpx;
}
