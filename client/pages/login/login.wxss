.container {
  position: relative;
  min-height: 100vh;
  background: linear-gradient(180deg, #bfe3ff 0%, #e8f4ff 65%, #ffffff 100%);
  padding: 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
}

/* 白天背景：太阳 + 白云 */
.sky-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  z-index: 0;
}

.sun {
  position: absolute;
  top: 90rpx;
  right: 80rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #fff6d8 0%, #ffd35c 100%);
  border: 4rpx solid #1a1a1a;
  box-shadow: 8rpx 8rpx 0 rgba(26, 26, 26, 0.18);
  animation: sun-bob 3.5s ease-in-out infinite;
}

@keyframes sun-bob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(10rpx); }
}

.cloud {
  position: absolute;
  background: #ffffff;
  border: 3rpx solid #1a1a1a;
  border-radius: 999rpx;
  opacity: 0.95;
  animation: cloud-drift 24s linear infinite;
}

.c1 { top: 130rpx; left: -240rpx; width: 240rpx; height: 64rpx; }
.c2 { top: 210rpx; left: -260rpx; width: 180rpx; height: 48rpx; animation-duration: 30s; animation-delay: 4s; }
.c3 { top: 320rpx; left: -220rpx; width: 220rpx; height: 56rpx; animation-duration: 26s; animation-delay: 8s; }

@keyframes cloud-drift {
  from { transform: translateX(0); }
  to { transform: translateX(820rpx); }
}

/* Logo区域 */
.logo-section {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
  padding-top: 30rpx;
}

.logo {
  width: 150rpx;
  height: 150rpx;
  background: rgba(255, 255, 255, 0.6);
  -webkit-backdrop-filter: blur(24rpx);
  backdrop-filter: blur(24rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 76rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 26, 26, 0.12);
}

.app-name {
  font-size: 46rpx;
  font-weight: 800;
  color: #2b4a6f;
  margin-bottom: 20rpx;
  text-shadow: 1rpx 1rpx 0 rgba(255, 255, 255, 0.8);
}

.subtitle {
  font-size: 30rpx;
  color: #3b5b7d;
  font-weight: 600;
}

/* 漫画风登录卡片 */
.form-section {
  position: relative;
  z-index: 1;
  background: rgba(255, 255, 255, 0.5);
  -webkit-backdrop-filter: blur(40rpx);
  backdrop-filter: blur(40rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 24rpx;
  padding: 40rpx 40rpx 44rpx;
  box-shadow: 0 12rpx 36rpx rgba(26, 26, 26, 0.14);
}

.wx-login {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wx-tips {
  font-size: 24rpx;
  color: #4b5a6a;
  margin-top: 16rpx;
  text-align: center;
}

.divider {
  display: flex;
  align-items: center;
  margin: 28rpx 0 24rpx;
}

.divider-line {
  flex: 1;
  height: 2rpx;
  background: rgba(43, 74, 111, 0.2);
}

.divider-text {
  padding: 0 30rpx;
  font-size: 24rpx;
  color: #999999;
}

/* 按钮：漫画质感 */
.form-section .weui-btn {
  width: 100%;
  margin-top: 4rpx;
}

.form-section .weui-btn_primary {
  background: #1a1a1a;
  border: none;
  color: #ffffff;
  box-shadow: 6rpx 6rpx 0 #ffe66d;
  border-radius: 16rpx;
}

.form-section .weui-btn_primary:active {
  box-shadow: 2rpx 2rpx 0 #ffe66d;
  transform: translate(4rpx, 4rpx);
}

.form-section .weui-btn_default {
  background: #ffffff;
  border: 3rpx solid #1a1a1a;
  color: #1a1a1a;
  box-shadow: 4rpx 4rpx 0 rgba(26, 26, 26, 0.18);
  border-radius: 16rpx;
  font-weight: 600;
}

.form-section .weui-btn_default:active {
  box-shadow: 1rpx 1rpx 0 rgba(26, 26, 26, 0.18);
  transform: translate(3rpx, 3rpx);
}
