<view class="container">
  <!-- 炫彩流星背景 -->
  <view class="meteor-bg">
    <view class="star s1"></view>
    <view class="star s2"></view>
    <view class="star s3"></view>
    <view class="star s4"></view>
    <view class="star s5"></view>
    <view class="star s6"></view>
    <view class="star s7"></view>
    <view class="star s8"></view>
    <view class="star s9"></view>
    <view class="star s10"></view>
    <view class="meteor m1"></view>
    <view class="meteor m2"></view>
    <view class="meteor m3"></view>
    <view class="meteor m4"></view>
    <view class="meteor m5"></view>
    <view class="meteor m6"></view>
    <view class="meteor m7"></view>
    <view class="meteor m8"></view>
  </view>

  <!-- Logo区域 -->
  <view class="logo-section">
    <view class="logo">🎓</view>
    <text class="app-name">校园便利圈</text>
    <text class="subtitle">登录</text>
  </view>

  <!-- 磨砂玻璃登录卡片 -->
  <view class="form-section">
    <view class="wx-login">
      <button
        class="weui-btn weui-btn_primary"
        open-type="getPhoneNumber"
        bindgetphonenumber="onGetPhoneNumber"
        loading="{{loading}}"
        disabled="{{loading}}"
      >📱 微信一键登录</button>
      <text class="wx-tips">使用微信手机号快捷登录，登录后可发布、交易、聊天</text>
    </view>

    <!-- 分割线 -->
    <view class="divider">
      <view class="divider-line"></view>
      <text class="divider-text">或</text>
      <view class="divider-line"></view>
    </view>

    <!-- 游客登录 -->
    <button
      class="weui-btn weui-btn_default"
      type="default"
      bindtap="guestLogin"
      loading="{{loading}}"
      disabled="{{loading}}"
    >游客登录（仅浏览）</button>
  </view>
</view>
