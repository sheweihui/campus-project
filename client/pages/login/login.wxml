<view class="container">
  <!-- Logo区域 -->
  <view class="logo-section">
    <view class="logo">🎓</view>
    <text class="app-name">校园便利圈</text>
    <text class="subtitle">登录</text>
  </view>

  <!-- 微信一键登录 -->
  <view class="form-section">
    <view class="wx-login">
      <button
        class="wx-btn"
        open-type="getPhoneNumber"
        bindgetphonenumber="onGetPhoneNumber"
        loading="{{loading}}"
        disabled="{{loading}}"
      >📱 微信一键登录</button>
      <text class="wx-tips">使用微信手机号快捷登录，登录后可发布、交易、聊天</text>
    </view>

    <!-- 分割线 -->
    <view class="divider">
      <view class="divider-line"></view>
      <text class="divider-text">或</text>
      <view class="divider-line"></view>
    </view>

    <!-- 游客登录 -->
    <button
      class="guest-btn"
      type="default"
      bindtap="guestLogin"
      loading="{{loading}}"
      disabled="{{loading}}"
    >游客登录（仅浏览）</button>
  </view>
</view>
