<view class="container">
  <!-- Logo区域 -->
  <view class="logo-section">
    <view class="logo">🎓</view>
    <text class="app-name">校园便利圈</text>
    <text class="subtitle">登录</text>
  </view>

  <!-- 登录表单 -->
  <view class="form-section">
    <form bindsubmit="onLogin">
      <!-- 学号输入 -->
      <view class="input-group">
        <view class="input-label">学号</view>
        <input
          class="input-field"
          type="number"
          placeholder="请输入学号"
          maxlength="10"
          name="stuId"
        />
      </view>

      <!-- 姓名输入 -->
      <view class="input-group">
        <view class="input-label">姓名</view>
        <input
          class="input-field"
          type="text"
          placeholder="请输入姓名"
          maxlength="10"
          name="name"
        />
      </view>

      <!-- 手机号输入 -->
      <view class="input-group">
        <view class="input-label">手机号</view>
        <input
          class="input-field"
          type="number"
          placeholder="请输入手机号"
          maxlength="11"
          name="phone"
        />
      </view>

      <!-- 密码输入 -->
      <view class="input-group">
        <view class="input-label">密码</view>
        <input
          class="input-field"
          type="password"
          placeholder="请输入密码"
          maxlength="20"
          name="pwd"
        />
      </view>

      <!-- 登录按钮 -->
      <button
        class="login-btn"
        type="primary"
        loading="{{loading}}"
        disabled="{{loading}}"
        formType="submit"
      >登录</button>
    </form>

    <!-- 提示信息 -->
    <view class="tips">
      <text class="tip-text">首次登录将自动初始化信息</text>
      <text class="tip-text">首次登录可自定义密码</text>
    </view>

    <!-- 分割线 -->
    <view class="divider">
      <view class="divider-line"></view>
      <text class="divider-text">或</text>
      <view class="divider-line"></view>
    </view>

    <!-- 游客登录 -->
    <button
      class="guest-btn"
      bindtap="guestLogin"
      loading="{{loading}}"
      disabled="{{loading}}"
    >游客登录（仅浏览）</button>
  </view>
</view>
