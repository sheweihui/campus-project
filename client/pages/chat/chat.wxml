<view class="container">
  <view class="chat-header">
    <view class="header-main">
      <view>
        <view class="header-title">{{otherUserInfo.nickName || '聊天'}}</view>
        <view class="header-info">{{otherUserInfo.phoneMask || ''}}</view>
      </view>
      <button class="subscribe-btn" size="mini" bindtap="requestChatSubscribe">消息提醒</button>
    </view>
  </view>

  <scroll-view 
    class="chat-content" 
    scroll-y 
    scroll-into-view="{{toView}}" 
    scroll-with-animation
  >
    <view 
      class="message-item {{item.senderId === myOpenid ? 'my-message' : 'other-message'}}"
      wx:for="{{messages}}" 
      wx:key="_id"
      id="msg-{{index}}"
    >
      <view class="message-avatar">
        <text>{{item.senderId === myOpenid ? '我' : (otherUserInfo.nickName || '对方')}}</text>
      </view>
      <view class="message-body">
        <view class="message-content">
          <text>{{item.content}}</text>
        </view>
        <view class="message-time">{{item.time}}</view>
      </view>
    </view>
  </scroll-view>

  <view class="chat-input-bar">
    <input 
      class="chat-input" 
      placeholder="输入消息..." 
      value="{{inputText}}" 
      bindinput="onInput"
      confirm-type="send"
      bindconfirm="sendMessage"
    />
    <button class="send-btn" bindtap="sendMessage" size="mini">发送</button>
  </view>
</view>
