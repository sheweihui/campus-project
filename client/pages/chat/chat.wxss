.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: transparent;
}

.chat-header {
  background: #333333;
  padding: 32rpx;
  color: #fff;
}

.header-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.header-info {
  font-size: 24rpx;
  opacity: 0.9;
}

.subscribe-btn {
  flex: 0 0 auto;
  min-width: 148rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 20rpx;
  border: none;
  border-radius: 28rpx;
  background: #ff9900;
  color: #fff;
  font-size: 24rpx;
}

.subscribe-btn::after {
  border: none;
}

.chat-content {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
}

.message-item {
  display: flex;
  margin-bottom: 32rpx;
  align-items: flex-start;
}

.my-message {
  flex-direction: row-reverse;
}

.message-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #333333;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
}

.other-message .message-avatar {
  margin-right: 16rpx;
}

.my-message .message-avatar {
  margin-left: 16rpx;
}

.message-body {
  display: flex;
  flex-direction: column;
  max-width: 480rpx;
}

.my-message .message-body {
  align-items: flex-end;
}

.other-message .message-body {
  align-items: flex-start;
}

.message-content {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}

.other-message .message-content {
  background: #fff;
  color: #333;
}

.my-message .message-content {
  background: #333333;
  color: #fff;
}

.message-time {
  font-size: 20rpx;
  color: #999;
  margin-top: 8rpx;
  text-align: center;
}

.chat-input-bar {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-top: 1rpx solid #e5e5e5;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #f5f7fa;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.send-btn {
  margin-left: 16rpx;
  background: #333333;
  color: #fff;
  border: none;
  border-radius: 36rpx;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
}

.send-btn::after {
  border: none;
}
