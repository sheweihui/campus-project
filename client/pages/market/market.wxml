<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input class="search-input" placeholder="搜索商品..." value="{{keyword}}" bindinput="onSearchInput" confirm-type="search" bindconfirm="onSearch" />
  </view>

  <!-- 分类筛选 -->
  <view class="category-bar">
    <scroll-view scroll-x class="category-scroll">
      <view class="category-list">
        <view class="category-item {{currentCategory === 'all' ? 'active' : ''}}" bindtap="selectCategory" data-category="all">全部</view>
        <view class="category-item {{currentCategory === 'books' ? 'active' : ''}}" bindtap="selectCategory" data-category="books">书籍</view>
        <view class="category-item {{currentCategory === 'digital' ? 'active' : ''}}" bindtap="selectCategory" data-category="digital">数码</view>
        <view class="category-item {{currentCategory === 'daily' ? 'active' : ''}}" bindtap="selectCategory" data-category="daily">生活用品</view>
        <view class="category-item {{currentCategory === 'others' ? 'active' : ''}}" bindtap="selectCategory" data-category="others">其他</view>
      </view>
    </scroll-view>
  </view>

  <!-- 商品列表 -->
  <view class="weui-cells">
    <view class="weui-cell weui-cell_access" wx:for="{{list}}" wx:key="_id" bindtap="goToDetail" data-id="{{item._id}}" hover-class="weui-cell_active">
      <view class="weui-cell__hd">
        <view class="list-thumb">
          <image wx:if="{{item.images && item.images.length > 0}}" src="{{item.images[0]}}" mode="aspectFill" />
          <text wx:else>🛒</text>
        </view>
      </view>
      <view class="weui-cell__bd">
        <view class="list-title-row"><text class="list-title">{{item.title}}</text></view>
        <view class="market-tags">
          <text class="tag tag-primary">{{categoryMap[item.category]}}</text>
          <text class="tag tag-secondary">{{conditionMap[item.condition]}}</text>
        </view>
        <view class="list-meta">
          <text class="list-price">¥{{item.price}}</text>
          <text>👁 {{item.viewCount || 0}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{!isLoading && hasMore}}">上拉加载更多</view>
  <view class="load-more" wx:if="{{!isLoading && !hasMore && list.length > 0}}">没有更多了</view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!isLoading && list.length === 0}}">
    <text class="empty-text">暂无商品</text>
  </view>
</view>

<!-- 发布按钮 -->
<view class="fab" bindtap="goToPublish">
  <text class="fab-icon">+</text>
</view>

<view class="refresh-fab" bindtap="onRefresh">↻</view>
