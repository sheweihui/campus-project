.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx 30rpx;
  border-radius: 40rpx;
  margin-bottom: 20rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 15rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.category-bar {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 20rpx 0;
}

.category-scroll {
  white-space: nowrap;
}

.category-list {
  display: flex;
  padding: 0 20rpx;
}

.category-item {
  display: inline-block;
  padding: 15rpx 30rpx;
  margin-right: 20rpx;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 30rpx;
}

.category-item.active {
  background: #333333;
  color: #fff;
}

.market-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}

.market-item {
  width: calc(50% - 20rpx);
  margin: 10rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.market-image {
  width: 100%;
  height: 300rpx;
}

.market-image.placeholder {
  height: 300rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}

.market-info {
  padding: 20rpx;
}

.market-title {
  display: block;
  font-size: 28rpx;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.market-tags {
  margin-bottom: 15rpx;
}

.tag-secondary {
  background: #f0f0f0;
  color: #666;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-left: 10rpx;
}

.market-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.market-price {
  font-size: 32rpx;
  color: #f44336;
  font-weight: bold;
}

.market-views {
  font-size: 24rpx;
  color: #999;
}
.refresh-fab {
  position: fixed;
  right: 30rpx;
  bottom: 120rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #fff;
  border: 3rpx solid #1a1a1a;
  box-shadow: 0 6rpx 0 rgba(26, 26, 26, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #1a1a1a;
  z-index: 99;
}
.refresh-fab:active {
  transform: scale(0.92);
}