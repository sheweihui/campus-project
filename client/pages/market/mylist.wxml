<view class="container">
  <!-- 状态筛选 -->
  <view class="tabs">
    <view class="tab {{currentTab === 'all' ? 'active' : ''}}" bindtap="switchTab" data-tab="all">全部</view>
    <view class="tab {{currentTab === 'onSale' ? 'active' : ''}}" bindtap="switchTab" data-tab="onSale">在售</view>
    <view class="tab {{currentTab === 'sold' ? 'active' : ''}}" bindtap="switchTab" data-tab="sold">已售出</view>
    <view class="tab {{currentTab === 'off' ? 'active' : ''}}" bindtap="switchTab" data-tab="off">已下架</view>
  </view>

  <!-- 列表 -->
  <view class="market-list">
    <view class="market-item" wx:for="{{list}}" wx:key="_id" bindtap="goToDetail" data-id="{{item._id}}">
      <image wx:if="{{item.imageUrls && item.imageUrls.length > 0}}" src="{{item.imageUrls[0]}}" class="item-image" mode="aspectFill" />
      <image wx:elif="{{item.images && item.images.length > 0}}" src="{{item.images[0]}}" class="item-image" mode="aspectFill" />
      <view wx:else class="item-image placeholder">🛒</view>
      <view class="item-info">
        <text class="item-title">{{item.title}}</text>
        <view class="item-tags">
          <text class="tag tag-primary">{{categoryMap[item.category]}}</text>
          <text class="status {{item.status}}">{{statusMap[item.status]}}</text>
        </view>
        <view class="item-footer">
          <text class="item-price">¥{{item.price}}</text>
          <text class="item-views">👁 {{item.viewCount || 0}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{!isLoading && hasMore}}">上拉加载更多</view>
  <view class="load-more" wx:if="{{!isLoading && !hasMore && list.length > 0}}">没有更多了</view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!isLoading && list.length === 0}}">
    <text class="empty-text">暂无发布记录</text>
    <button class="btn-primary" bindtap="goToPublish" style="margin-top: 40rpx;">去发布</button>
  </view>
</view>
