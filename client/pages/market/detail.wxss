.image-swiper {
  height: 500rpx;
  margin: -30rpx -30rpx 30rpx;
  border-radius: 16rpx 16rpx 0 0;
  overflow: hidden;
}

.image-swiper image {
  width: 100%;
  height: 100%;
}

.image-placeholder {
  height: 500rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
  margin: -30rpx -30rpx 30rpx;
  border-radius: 16rpx 16rpx 0 0;
}

.price-section {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.current-price {
  font-size: 48rpx;
  color: #f44336;
  font-weight: bold;
  margin-right: 20rpx;
}

.original-price {
  font-size: 28rpx;
  color: #999;
  text-decoration: line-through;
}

.detail-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.detail-tags {
  margin-bottom: 30rpx;
}

.tag-secondary {
  background: #f0f0f0;
  color: #666;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  margin-left: 10rpx;
}

.status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 10rpx;
}

.status.onSale {
  background: #e8f5e9;
  color: #4CAF50;
}

.status.sold {
  background: #ffebee;
  color: #f44336;
}

.status.off {
  background: #f5f5f5;
  color: #999;
}

.detail-section {
  margin-bottom: 30rpx;
}

.section-label {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.section-content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
}

.section-content.contact {
  color: #4CAF50;
  font-weight: bold;
}

.detail-time {
  font-size: 24rpx;
  color: #999;
  margin-top: 30rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.bar-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  margin: 0 10rpx;
  background: #f0f0f0;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #333;
}

.bar-btn.disabled {
  background: #e0e0e0;
  color: #999;
}

.bar-btn.delete {
  background: #ffebee;
  color: #f44336;
}

.bar-btn.primary {
  background: linear-gradient(135deg, #4CAF50, #45a049);
  color: #fff;
}