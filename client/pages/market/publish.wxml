<view class="container">
  <view class="card">
    <!-- 商品名称 -->
    <view class="form-item">
      <text class="form-label">商品名称 <text class="required">*</text></text>
      <input class="form-input" placeholder="请输入商品名称" value="{{form.title}}" bindinput="onInput" data-field="title" />
    </view>

    <!-- 价格 -->
    <view class="form-item">
      <text class="form-label">价格 <text class="required">*</text></text>
      <view class="price-input">
        <text class="price-symbol">¥</text>
        <input class="form-input" type="digit" placeholder="请输入价格" value="{{form.price}}" bindinput="onPriceInput" />
      </view>
      <text class="amount-hint" wx:if="{{priceHint}}">{{priceHint}}</text>
    </view>

    <!-- 原价 -->
    <view class="form-item">
      <text class="form-label">原价（选填）</text>
      <view class="price-input">
        <text class="price-symbol">¥</text>
        <input class="form-input" type="digit" placeholder="请输入原价" value="{{form.originalPrice}}" bindinput="onOriginalPriceInput" />
      </view>
      <text class="amount-hint" wx:if="{{originalPriceHint}}">{{originalPriceHint}}</text>
    </view>

    <!-- 分类 -->
    <view class="form-item">
      <text class="form-label">分类 <text class="required">*</text></text>
      <picker bindchange="onCategoryChange" value="{{categoryIndex}}" range="{{categories}}" range-key="name">
        <view class="picker">
          {{form.category ? categoryMap[form.category] : '请选择分类'}}
          <text class="picker-arrow">></text>
        </view>
      </picker>
    </view>

    <!-- 成色 -->
    <view class="form-item">
      <text class="form-label">成色 <text class="required">*</text></text>
      <picker bindchange="onConditionChange" value="{{conditionIndex}}" range="{{conditions}}" range-key="name">
        <view class="picker">
          {{form.condition ? conditionMap[form.condition] : '请选择成色'}}
          <text class="picker-arrow">></text>
        </view>
      </picker>
    </view>

    <!-- 商品描述 -->
    <view class="form-item">
      <text class="form-label">商品描述 <text class="required">*</text></text>
      <textarea class="form-textarea" placeholder="请详细描述商品情况、使用情况等" value="{{form.description}}" bindinput="onInput" data-field="description" />
    </view>

    <!-- 联系方式 -->
    <view class="form-item">
      <text class="form-label">联系方式 <text class="required">*</text></text>
      <input class="form-input" placeholder="请输入手机号或微信号" value="{{form.contact}}" bindinput="onInput" data-field="contact" />
      <view class="phone-suggest" wx:if="{{recommendPhone && form.contact !== recommendPhone}}" bindtap="fillPhone" data-field="contact">
        <text class="phone-suggest-icon">📞</text>
        <text>推荐使用我的手机号：{{recommendPhone}}</text>
      </view>
    </view>

    <!-- 图片上传 -->
    <view class="form-item">
      <text class="form-label">商品图片</text>
      <view class="image-list">
        <view class="image-item" wx:for="{{form.images}}" wx:key="index">
          <image src="{{item}}" mode="aspectFill" bindtap="previewImage" data-url="{{item}}" />
          <view class="delete-btn" bindtap="deleteImage" data-index="{{index}}">×</view>
        </view>
        <view class="upload-box" bindtap="chooseImage" wx:if="{{form.images.length < 6}}">
          <text class="upload-icon">+</text>
          <text class="upload-text">添加图片</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <button class="btn-primary submit-btn" bindtap="submit">发布商品</button>
</view>