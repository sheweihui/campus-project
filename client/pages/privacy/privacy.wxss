.doc {
  padding: 32rpx 32rpx 64rpx;
  background: #ffffff;
  min-height: 100vh;
}

.doc-title {
  font-size: 40rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 12rpx;
}

.doc-meta {
  font-size: 24rpx;
  color: #999999;
  text-align: center;
  margin-bottom: 32rpx;
}

.doc-h {
  font-size: 30rpx;
  font-weight: 600;
  margin: 32rpx 0 12rpx;
}

.doc-p {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.7;
  margin-bottom: 12rpx;
}

.em {
  font-weight: 600;
  color: #d9480f;
}
