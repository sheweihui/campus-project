.page-withdraws {
  padding-bottom: 40rpx;
}

.tab-bar {
  display: flex;
  padding: 16rpx 24rpx;
  background: #fff;
  gap: 12rpx;
  border-bottom: 1rpx solid #f3f4f6;
}
.tab-item {
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #6b7280;
  background: #f3f4f6;
}
.tab-item.active {
  background: #333333;
  color: #fff;
}

.summary-bar {
  padding: 16rpx 24rpx;
  color: #9ca3af;
  font-size: 24rpx;
}

.withdraw-list {
  padding: 0 24rpx;
}
.withdraw-card {
  margin: 12rpx 0;
}
.wc-header {
  margin-bottom: 16rpx;
}
.wc-amount {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.wc-body {
  border-top: 1rpx solid #f9fafb;
  padding-top: 16rpx;
}
.wc-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
}
.wc-label {
  font-size: 24rpx;
  color: #9ca3af;
}
.wc-value {
  font-size: 24rpx;
  color: #1a1a1a;
  max-width: 60%;
  text-align: right;
  word-break: break-all;
}
.wc-value.mono {
  font-family: monospace;
  font-size: 20rpx;
}
.wc-value.error {
  color: #d4380d;
}

.wc-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f9fafb;
}
