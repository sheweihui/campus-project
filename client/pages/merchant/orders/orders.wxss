.page-orders {
  padding-bottom: 40rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  gap: 12rpx;
}
.search-input {
  flex: 1;
  background: #f3f4f6;
  border-radius: 10rpx;
  padding: 14rpx 20rpx;
  font-size: 26rpx;
}
.search-btn {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0) 45%), rgba(51, 51, 51, 0.7);
  -webkit-backdrop-filter: blur(24rpx);
  backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  color: #fff;
  padding: 14rpx 24rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
}
.add-btn {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0) 45%), rgba(51, 51, 51, 0.7);
  -webkit-backdrop-filter: blur(24rpx);
  backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  color: #fff;
  padding: 14rpx 20rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.filter-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 14rpx 16rpx;
  color: #6b7280;
  font-size: 26rpx;
}

/* 标签滚动 */
.tab-scroll {
  white-space: nowrap;
  background: #fff;
  border-bottom: 1rpx solid #f3f4f6;
}
.tabs {
  display: inline-flex;
  padding: 16rpx 24rpx;
  gap: 12rpx;
}
.tabs-status {
  padding-top: 0;
}
.tab-item {
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #6b7280;
  background: #f3f4f6;
  display: inline-block;
}
.tab-item.active {
  background: #333333;
  color: #fff;
}
.tab-item-sm {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #6b7280;
  background: #f3f4f6;
  display: inline-block;
}
.tab-item-sm.active {
  background: #eef1ff;
  color: #333333;
  font-weight: 500;
}

/* 筛选面板 */
.filter-panel {
  margin: 16rpx 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 12rpx;
}
.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}
.filter-label {
  font-size: 26rpx;
  color: #6b7280;
}
.filter-value {
  font-size: 26rpx;
  color: #333333;
}
.filter-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}

/* 汇总 */
.summary-bar {
  padding: 16rpx 24rpx;
  color: #9ca3af;
  font-size: 24rpx;
}

/* 订单列表 */
.order-list {
  padding: 0 24rpx;
}
.order-item {
  margin: 12rpx 0;
}
.order-header {
  margin-bottom: 12rpx;
}
.order-type-tag {
  font-size: 22rpx;
  background: #eef1ff;
  color: #333333;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
}
.order-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.order-body {
  margin-bottom: 12rpx;
}
.order-people {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.6;
}
.people-label {
  color: #9ca3af;
}
.order-footer {
  padding-top: 12rpx;
  border-top: 1rpx solid #f9fafb;
}
.order-time {
  font-size: 22rpx;
  color: #9ca3af;
}
.order-commission {
  font-size: 22rpx;
  color: #b25e00;
}

.page-orders {
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.order-remark {
  background: #fff7e6;
  border-radius: 8rpx;
  padding: 10rpx 14rpx;
  font-size: 22rpx;
  color: #8a6d1a;
  margin: 8rpx 0;
}