.page-finance {
  padding-bottom: 40rpx;
}

/* 收入头部 */
.revenue-header {
  background: #333333;
  padding: 40rpx 32rpx 48rpx;
  text-align: center;
}
.revenue-label {
  color: rgba(255,255,255,0.6);
  font-size: 24rpx;
  margin-bottom: 8rpx;
}
.revenue-value {
  color: #fff;
  font-size: 56rpx;
  font-weight: 700;
}
.revenue-sub {
  color: rgba(255,255,255,0.5);
  font-size: 24rpx;
  margin-top: 8rpx;
}
.revenue-period {
  display: block;
  margin-top: 6rpx;
}

/* 指标 */
.kpi-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 16rpx;
  margin-top: -20rpx;
  box-sizing: border-box;
}
.kpi-card {
  box-sizing: border-box;
  width: calc(50% - 16rpx);
  margin: 8rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
}
.kpi-label {
  font-size: 24rpx;
  color: #8a8a9a;
  margin-bottom: 8rpx;
}
.kpi-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.kpi-value.accent { color: #333333; }
.kpi-value.warn { color: #d4380d; }

/* 抽成率 */
.rate-display {
  text-align: center;
  padding: 16rpx 0;
}
.rate-number {
  font-size: 48rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 16rpx;
}
.rate-bar-bg {
  height: 16rpx;
  background: #f3f4f6;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}
.rate-bar-fill {
  height: 100%;
  background: #333333;
  border-radius: 8rpx;
  transition: width 0.5s;
}
.rate-note {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 用户余额列表 */
.finance-list {
  display: flex;
  flex-direction: column;
}
.finance-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f9fafb;
}
.finance-item:last-child {
  border-bottom: none;
}
.fi-id {
  font-size: 26rpx;
  font-weight: 500;
  color: #1a1a1a;
}
.fi-openid {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}
.fi-right {
  text-align: right;
}
.fi-balance {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.fi-meta {
  font-size: 20rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

/* 提现列表 */
.withdraw-list {
  display: flex;
  flex-direction: column;
}
.withdraw-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f9fafb;
}
.withdraw-item:last-child {
  border-bottom: none;
}
.wi-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.wi-right {
  text-align: right;
}
.wi-time {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

.card-more {
  font-size: 24rpx;
  color: #333333;
}
