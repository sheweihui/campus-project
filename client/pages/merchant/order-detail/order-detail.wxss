.page-detail {
  padding-bottom: 40rpx;
}

.amount-card {
  background: #333333;
  padding: 48rpx 32rpx;
  text-align: center;
}
.amount-value {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
}
.amount-status {
  margin-top: 16rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f9fafb;
}
.info-row:last-child {
  border-bottom: none;
}
.info-label {
  font-size: 26rpx;
  color: #6b7280;
}
.info-value {
  font-size: 26rpx;
  color: #1a1a1a;
  font-weight: 500;
}
.info-value.mono {
  font-family: monospace;
  font-size: 20rpx;
  color: #9ca3af;
}
.info-value.amount {
  font-weight: 700;
  font-size: 30rpx;
}
.info-value.commission {
  color: #b25e00;
  font-weight: 600;
}
.info-value.seller-amount {
  color: #1a7f37;
  font-weight: 600;
}

/* 操作按钮 */
.detail-actions {
  display: flex;
  gap: 20rpx;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.action-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.action-btn.edit {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0) 45%), rgba(51, 51, 51, 0.7);
  -webkit-backdrop-filter: blur(24rpx);
  backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

.action-btn.delete {
  background: #fee2e2;
  color: #d4380d;
}
