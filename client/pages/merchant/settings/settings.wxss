.page-settings {
  padding-bottom: 40rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f9fafb;
}
.info-row:last-child {
  border-bottom: none;
}
.info-label {
  font-size: 26rpx;
  color: #6b7280;
}
.info-value {
  font-size: 26rpx;
  color: #1a1a1a;
  font-weight: 500;
}
.info-value.mono {
  font-family: monospace;
  font-size: 22rpx;
  color: #9ca3af;
}
.info-value.accent {
  color: #333333;
}

.rate-note {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background: #fef3c7;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #92400e;
  line-height: 1.5;
}

/* 快捷入口 */
.shortcut-grid {
  display: flex;
  flex-wrap: wrap;
}
.shortcut-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}
.shortcut-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}
.shortcut-label {
  font-size: 24rpx;
  color: #6b7280;
}

/* 操作列表 */
.action-list {
  display: flex;
  flex-direction: column;
}
.action-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f9fafb;
}
.action-item:last-child {
  border-bottom: none;
}
.action-label {
  font-size: 26rpx;
  color: #1a1a1a;
}
.action-arrow {
  font-size: 32rpx;
  color: #9ca3af;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 48rpx 24rpx;
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 1.8;
}

.page-settings {
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}
