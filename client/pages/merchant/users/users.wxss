.page-users {
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  gap: 12rpx;
}
.search-input {
  flex: 1;
  background: #f3f4f6;
  border-radius: 10rpx;
  padding: 14rpx 20rpx;
  font-size: 26rpx;
}
.search-btn {
  background: #333333;
  color: #fff;
  padding: 14rpx 24rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
}

.summary-bar {
  padding: 16rpx 24rpx;
  color: #9ca3af;
  font-size: 24rpx;
}

.user-list {
  padding: 0 24rpx;
}
.user-card {
  margin: 12rpx 0;
}
.user-header {
  margin-bottom: 16rpx;
}
.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.user-id {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}
.user-balance {
  text-align: right;
}
.balance-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a7f37;
}
.balance-label {
  font-size: 20rpx;
  color: #9ca3af;
}

.user-stats {
  display: flex;
  padding: 16rpx 0;
  border-top: 1rpx solid #f9fafb;
  border-bottom: 1rpx solid #f9fafb;
  margin-bottom: 12rpx;
}
.stat-item {
  flex: 1;
  text-align: center;
}
.stat-value {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.stat-label {
  display: block;
  font-size: 20rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.user-footer {
  padding-top: 8rpx;
}
.user-time {
  font-size: 22rpx;
  color: #9ca3af;
}
.user-actions {
  display: flex;
  justify-content: flex-end;
  padding-top: 12rpx;
}
.msg-btn {
  background: #333333;
  color: #fff;
  padding: 10rpx 28rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  border: 2rpx solid #1a1a1a;
}

.broadcast-btn {
  background: #ffe66d;
  color: #1a1a1a;
  padding: 14rpx 24rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  border: 2rpx solid #1a1a1a;
  font-weight: 600;
}