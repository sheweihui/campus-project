.page-posts {
  padding-bottom: 40rpx;
}

.tab-scroll {
  white-space: nowrap;
  background: #fff;
}
.tabs {
  display: inline-flex;
  padding: 16rpx 24rpx;
  gap: 12rpx;
}
.tab-item {
  padding: 12rpx 28rpx;
  border-radius: 20rpx;
  background: #f3f4f6;
  font-size: 26rpx;
  color: #666;
}
.tab-item.active {
  background: #ffe66d;
  border: 2rpx solid #1a1a1a;
  color: #1a1a1a;
  font-weight: 700;
}
.tabs-status {
  padding-top: 8rpx;
}
.tab-item-sm {
  padding: 8rpx 22rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
  font-size: 24rpx;
  color: #666;
}
.tab-item-sm.active {
  background: #ffe66d;
  border: 2rpx solid #1a1a1a;
  color: #1a1a1a;
  font-weight: 700;
}

.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  gap: 12rpx;
}
.search-input {
  flex: 1;
  background: #f3f4f6;
  border-radius: 10rpx;
  padding: 14rpx 20rpx;
  font-size: 26rpx;
}
.search-btn {
  background: #333333;
  color: #fff;
  padding: 14rpx 24rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
}

.summary-bar {
  padding: 16rpx 24rpx;
  color: #9ca3af;
  font-size: 24rpx;
}

.post-list {
  padding: 0 24rpx;
}
.post-card {
  margin: 12rpx 0;
}
.pc-header {
  margin-bottom: 10rpx;
}
.pc-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  flex: 1;
}
.pc-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 10rpx;
}
.pc-amount {
  color: #1a7f37;
  font-weight: 700;
}
.pc-remark {
  background: #fff7e6;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  font-size: 24rpx;
  color: #8a6d1a;
  margin-bottom: 12rpx;
}
.pc-remark-label {
  font-weight: 600;
}
.pc-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
}

.overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.overlay-panel {
  width: 620rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-sizing: border-box;
}
.overlay-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  text-align: center;
}
.form-item {
  margin-bottom: 24rpx;
}
.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}
.form-input {
  background: #f3f4f6;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}
.picker-value {
  color: #1a1a1a;
}
.form-textarea {
  width: 100%;
  height: 180rpx;
  box-sizing: border-box;
  background: #f3f4f6;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}
.overlay-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 8rpx;
}