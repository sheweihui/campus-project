.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}

.banner-list {
  margin-bottom: 20rpx;
}

.banner-item {
  display: flex;
  align-items: center;
  background: #f8f8f8;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.banner-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.banner-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.banner-index {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.banner-link {
  font-size: 24rpx;
  color: #999;
}

.banner-actions {
  display: flex;
  gap: 16rpx;
}

.btn-small {
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  background: #333333;
  color: #fff;
  border-radius: 8rpx;
}

.btn-small.btn-danger {
  background: #f44336;
}

.btn-add {
  width: 100%;
  padding: 24rpx;
  background: #fff;
  border: 2rpx dashed #ccc;
  color: #666;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.form-item {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.form-item.column {
  flex-direction: column;
  align-items: flex-start;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-left: 16rpx;
}

.form-input {
  width: 100%;
  padding: 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 28rpx;
  margin-top: 12rpx;
}

.form-textarea {
  width: 100%;
  padding: 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 28rpx;
  margin-top: 12rpx;
  height: 160rpx;
}

.btn-save {
  width: 100%;
  padding: 28rpx;
  background: #333333;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: bold;
}