.banner-section {
  margin: 0 0 24rpx;
}

.banner-swiper {
  width: 100%;
  height: 300rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 28rpx rgba(31, 41, 55, 0.08);
}

.banner-image {
  width: 100%;
  height: 100%;
}

.announcement {
  display: flex;
  align-items: center;
  background: #fdf6ec;
  padding: 24rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #ff9900;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.announcement-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.announcement-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.announcement-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.announcement-text {
  font-size: 24rpx;
  color: #666;
}

.container {
  min-height: 100vh;
  background: #faf8f3;
  padding: 20rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx 30rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #e4e7ed;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 15rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 20rpx;
  color: #1a1a1a;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.more {
  font-size: 26rpx;
  color: #1a1a1a;
  font-weight: 700;
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.grid-item {
  width: 25%;
  text-align: center;
  padding: 20rpx 0;
}

.grid-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin: 0 auto 10rpx;
}

.grid-icon.lostfound {
  background: #ff9900;
}

.grid-icon.market {
  background: #f5f5f5;
}

.grid-icon.help {
  background: #19be6b;
}

.grid-icon.tools {
  background: #909399;
}

.grid-text {
  font-size: 26rpx;
  color: #666;
}

/* 常用功能卡片（参考 info-button 风格） */
.func-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.func-card {
  width: calc(50% - 12rpx);
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 3rpx solid #1a1a1a;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 6rpx 6rpx 0 rgba(26, 26, 26, 0.14);
  box-sizing: border-box;
}

.func-card-active {
  background: #fff6e5;
  box-shadow: 2rpx 2rpx 0 rgba(26, 26, 26, 0.14);
}

.func-icon {
  width: 84rpx;
  height: 84rpx;
  font-size: 56rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.func-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.func-main {
  font-size: 30rpx;
  font-weight: 800;
  color: #303133;
}

.func-sub {
  font-size: 18rpx;
  color: #909399;
  margin-top: 4rpx;
}

/* 任务风格列表（参考 mission-list-item） */
.mission-list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  border: 3rpx solid #1a1a1a;
  box-shadow: 6rpx 6rpx 0 rgba(26, 26, 26, 0.12);
  margin-bottom: 24rpx;
}

.mission-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f2f3f5;
}

.mission-item:last-child {
  border-bottom: none;
}

.mission-item-active {
  background: #f8f8f8;
}

.mission-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 14rpx;
  border: 2rpx solid #1a1a1a;
  background: #fff6e5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  overflow: hidden;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.mission-thumb image {
  width: 100%;
  height: 100%;
}

.mission-body {
  flex: 1;
  min-width: 0;
}

.mission-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #303133;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mission-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #909399;
}

.mission-action {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 2rpx solid #1a1a1a;
  background: #ffe66d;
  color: #1a1a1a;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 流星雨动画（纯前端 CSS） */
.sky-card {
  position: relative;
  height: 280rpx;
  border-radius: 24rpx;
  overflow: visible;
  border: 3rpx solid #1a1a1a;
  box-shadow: 8rpx 8rpx 0 rgba(26, 26, 26, 0.16);
}

/* 白天内容单独裁切，避免白云跑出卡片 */
.sky-clip {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  border-radius: 24rpx;
}

.sky-card.night {
  background: linear-gradient(180deg, #0b1026 0%, #1b2a5e 100%);
}

.sky-card.day {
  background: linear-gradient(180deg, #bfe3ff 0%, #e8f4ff 65%, #ffffff 100%);
}

/* 月亮 */
.moon {
  position: absolute;
  top: 44rpx;
  right: 56rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 3rpx solid #1a1a1a;
  background: radial-gradient(circle at 35% 35%, #ffffff 0%, #e9e9f2 100%);
  box-shadow: 0 0 40rpx rgba(255, 255, 255, 0.5), inset -14rpx -10rpx 0 rgba(0, 0, 0, 0.05);
}

.moon::after {
  content: '';
  position: absolute;
  top: 26rpx;
  left: 22rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.08);
  box-shadow: 26rpx 18rpx 0 rgba(0, 0, 0, 0.06), 12rpx 34rpx 0 rgba(0, 0, 0, 0.05);
}

/* 太阳 */
.sun {
  position: absolute;
  top: 40rpx;
  right: 52rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 3rpx solid #1a1a1a;
  background: radial-gradient(circle at 35% 35%, #fff6d8 0%, #ffd35c 100%);
  box-shadow: 0 0 60rpx rgba(255, 205, 90, 0.85);
  animation: sun-pulse 3s ease-in-out infinite;
}

@keyframes sun-pulse {
  0%, 100% { box-shadow: 0 0 40rpx rgba(255, 205, 90, 0.7); }
  50% { box-shadow: 0 0 70rpx rgba(255, 205, 90, 0.95); }
}

/* 白云 */
.cloud {
  position: absolute;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(26, 26, 26, 0.6);
  border-radius: 999rpx;
  opacity: 0.9;
  animation: cloud-drift 20s linear infinite;
}

.c1 { top: 60rpx; left: -220rpx; width: 220rpx; height: 56rpx; }
.c2 { top: 130rpx; left: -260rpx; width: 170rpx; height: 44rpx; animation-duration: 28s; animation-delay: 5s; }
.c3 { top: 190rpx; left: -240rpx; width: 240rpx; height: 60rpx; animation-duration: 24s; animation-delay: 9s; }

@keyframes cloud-drift {
  from { transform: translateX(0); }
  to { transform: translateX(820rpx); }
}

.star {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #fff;
  opacity: 0.7;
  animation: twinkle 2.4s ease-in-out infinite;
}

.s1 { top: 40rpx; left: 12%; animation-delay: 0s; }
.s2 { top: 80rpx; left: 30%; animation-delay: 0.6s; }
.s3 { top: 30rpx; left: 52%; animation-delay: 1.1s; }
.s4 { top: 110rpx; left: 68%; animation-delay: 0.3s; }
.s5 { top: 60rpx; left: 84%; animation-delay: 1.5s; }
.s6 { top: 140rpx; left: 42%; animation-delay: 0.9s; }
.s7 { top: 170rpx; left: 20%; animation-delay: 1.8s; }
.s8 { top: 150rpx; left: 90%; animation-delay: 0.2s; }

@keyframes twinkle {
  0%, 100% { opacity: 0.2; }
  50% { opacity: 0.9; }
}

.meteor {
  position: absolute;
  z-index: 999;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #fff;
  opacity: 0;
  box-shadow: 0 0 12rpx rgba(255, 255, 255, 0.8);
  animation: meteor-fall 3.2s linear infinite;
}

.meteor::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 240rpx;
  height: 2rpx;
  transform-origin: left center;
  transform: rotate(-38deg);
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.9) 0%, rgba(190, 220, 255, 0.25) 60%, rgba(255, 255, 255, 0) 100%);
}

.m1 { top: 30rpx; left: 18%; animation-duration: 2.8s; animation-delay: 0s; }
.m2 { top: 90rpx; left: 55%; animation-duration: 3.6s; animation-delay: 1.1s; }
.m3 { top: 140rpx; left: 32%; animation-duration: 3.1s; animation-delay: 2.2s; }
.m4 { top: 60rpx; left: 78%; animation-duration: 3.9s; animation-delay: 0.7s; }
.m5 { top: 190rpx; left: 50%; animation-duration: 3.4s; animation-delay: 1.8s; }
.m6 { top: 120rpx; left: 8%; animation-duration: 2.5s; animation-delay: 2.7s; }

@keyframes meteor-fall {
  0% {
    transform: translate3d(0, 0, 0);
    opacity: 0;
  }
  4% {
    opacity: 1;
  }
  22% {
    opacity: 1;
  }
  45% {
    opacity: 0;
    transform: translate3d(-260rpx, 320rpx, 0);
  }
  100% {
    opacity: 0;
    transform: translate3d(-260rpx, 320rpx, 0);
  }
}

.sky-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 90rpx;
  background: linear-gradient(180deg, rgba(11, 16, 38, 0) 0%, rgba(11, 16, 38, 0.55) 100%);
}

.sky-text {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 24rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.92);
  font-weight: 800;
  font-size: 34rpx;
  letter-spacing: 4rpx;
  text-shadow: 2rpx 2rpx 0 rgba(0, 0, 0, 0.35);
}

.day-text {
  color: #3b5b7d;
  text-shadow: 0 1rpx 4rpx rgba(255, 255, 255, 0.6);
}

/* 内容一体卡片 */
.content-box {
  background: #ffffff;
  border: 3rpx solid #1a1a1a;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 6rpx 6rpx 0 rgba(26, 26, 26, 0.12);
  margin-bottom: 24rpx;
}

/* 内容切换导航（卡片头，与内容相连） */
.comic-tabs {
  display: flex;
  background: #ffffff;
  border-bottom: 3rpx solid #1a1a1a;
}

.comic-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  font-weight: 700;
  color: #666666;
}

.comic-tab + .comic-tab {
  border-left: 2rpx solid #1a1a1a;
}

.comic-tab.active {
  background: #ffe66d;
  color: #1a1a1a;
}

.content-body {
  padding: 24rpx 20rpx 8rpx;
}

.content-body .section-title {
  margin-bottom: 16rpx;
}

.content-box .mission-list {
  border: none;
  box-shadow: none;
  margin: 0;
}

.content-box .mission-item {
  border-bottom: 2rpx solid #f0f0f0;
}

.content-box .mission-item:last-child {
  border-bottom: none;
}

.content-more {
  text-align: center;
  padding: 22rpx 0;
  margin-top: 10rpx;
  border-top: 2rpx solid #f0f0f0;
  color: #1a1a1a;
  font-size: 28rpx;
  font-weight: 700;
}

.list {
  margin-top: 10rpx;
}

.list-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.list-item:last-child {
  border-bottom: none;
}

.item-left {
  margin-right: 20rpx;
}

.item-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.item-image.placeholder {
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.help-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.help-icon.carpool {
  background: linear-gradient(135deg, #2196F3, #1976D2);
}

.help-icon.express {
  background: linear-gradient(135deg, #FF9800, #F57C00);
}

.help-icon.partner {
  background: linear-gradient(135deg, #9C27B0, #7B1FA2);
}

.help-icon.other {
  background: linear-gradient(135deg, #00BCD4, #0097A7);
}

.item-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-header {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.item-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-left: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-desc {
  font-size: 26rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 10rpx;
}

.item-time {
  font-size: 24rpx;
  color: #999;
}

.market-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}

.market-item {
  width: calc(50% - 20rpx);
  margin: 10rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  overflow: hidden;
}

.market-image {
  width: 100%;
  height: 300rpx;
}

.market-image.placeholder {
  height: 300rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}

.market-title {
  display: block;
  font-size: 28rpx;
  padding: 15rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.market-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 15rpx 15rpx;
}

.market-price {
  font-size: 32rpx;
  color: #f44336;
  font-weight: bold;
}

.market-condition {
  font-size: 24rpx;
  color: #999;
  background: #f0f0f0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
