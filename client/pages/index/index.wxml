<view class="container">
  <!-- 天空卡片：夜晚流星雨 / 白天太阳白云，按时间自动切换 -->
  <view class="banner-section">
    <view class="sky-card {{isNight ? 'night' : 'day'}}">
      <block wx:if="{{isNight}}">
        <view class="moon"></view>
        <view class="star s1"></view>
        <view class="star s2"></view>
        <view class="star s3"></view>
        <view class="star s4"></view>
        <view class="star s5"></view>
        <view class="star s6"></view>
        <view class="star s7"></view>
        <view class="star s8"></view>
        <view class="meteor m1"></view>
        <view class="meteor m2"></view>
        <view class="meteor m3"></view>
        <view class="meteor m4"></view>
        <view class="meteor m5"></view>
        <view class="meteor m6"></view>
        <view class="sky-overlay"></view>
        <view class="sky-text">✨ 欢迎来到校园便利圈</view>
      </block>
      <block wx:else>
        <view class="sky-clip">
          <view class="sun"></view>
          <view class="cloud c1"></view>
          <view class="cloud c2"></view>
          <view class="cloud c3"></view>
          <view class="sky-text day-text">☀️ 欢迎来到校园便利圈</view>
        </view>
      </block>
    </view>
  </view>

  <!-- 常用功能 -->
    <view class="announcement" wx:if="{{announcement && announcement.show && announcement.content}}">
    <view class="announcement-icon">📢</view>
    <view class="announcement-content">
      <text class="announcement-title">{{announcement.title || '平台公告'}}</text>
      <text class="announcement-text">{{announcement.content}}</text>
    </view>
  </view>

<view class="section-title">常用功能</view>
  <view class="func-grid">
    <view class="func-card" bindtap="navigateTo" data-page="lostfound" hover-class="func-card-active">
      <view class="func-icon lf">📋</view>
      <view class="func-text">
        <text class="func-main">失物招领</text>
      </view>
    </view>
    <view class="func-card" bindtap="navigateTo" data-page="market" hover-class="func-card-active">
      <view class="func-icon mk">🛒</view>
      <view class="func-text">
        <text class="func-main">二手集市</text>
      </view>
    </view>
    <view class="func-card" bindtap="navigateTo" data-page="help" hover-class="func-card-active">
      <view class="func-icon hp">🤝</view>
      <view class="func-text">
        <text class="func-main">校园互助</text>
      </view>
    </view>
    <view class="func-card" bindtap="navigateTo" data-page="tools" hover-class="func-card-active">
      <view class="func-icon tp">🗺️</view>
      <view class="func-text">
        <text class="func-main">校园地图</text>
      </view>
    </view>
  </view>

  <!-- 内容切换导航 + 信息一体卡片 -->
  <view class="content-box">
    <view class="comic-tabs">
      <view class="comic-tab {{activeTab === 'market' ? 'active' : ''}}" data-tab="market" bindtap="switchTab">二手商品</view>
      <view class="comic-tab {{activeTab === 'help' ? 'active' : ''}}" data-tab="help" bindtap="switchTab">互助信息</view>
      <view class="comic-tab {{activeTab === 'lostfound' ? 'active' : ''}}" data-tab="lostfound" bindtap="switchTab">失物招领</view>
    </view>

    <view class="content-body">
      <view class="section-title">{{activeTab === 'market' ? '最新二手商品' : (activeTab === 'help' ? '最新互助信息' : '最新失物招领')}}</view>

      <!-- 二手商品 -->
      <view class="mission-list" wx:if="{{activeTab === 'market' && marketList.length > 0}}">
        <view class="mission-item" wx:for="{{marketList}}" wx:key="_id" bindtap="goToDetail" data-type="market" data-id="{{item._id}}" hover-class="mission-item-active">
          <view class="mission-thumb">
            <image wx:if="{{item.images && item.images.length > 0}}" src="{{item.images[0]}}" mode="aspectFill" />
            <text wx:else>🛒</text>
          </view>
          <view class="mission-body">
            <view class="mission-title">{{item.title}}</view>
            <view class="mission-meta"><text class="list-price">¥{{item.price}}</text><text> | {{conditionMap[item.condition]}}</text></view>
          </view>
          <view class="mission-action">></view>
        </view>
      </view>
      <view class="empty-state" wx:if="{{activeTab === 'market' && marketList.length === 0}}"><text class="empty-text">暂无二手商品</text></view>

      <!-- 互助信息 -->
      <view class="mission-list" wx:if="{{activeTab === 'help' && helpList.length > 0}}">
        <view class="mission-item" wx:for="{{helpList}}" wx:key="_id" bindtap="goToDetail" data-type="{{item.type}}" data-id="{{item._id}}" hover-class="mission-item-active">
          <view class="mission-thumb">{{helpIconMap[item.type]}}</view>
          <view class="mission-body">
            <view class="mission-title">{{item.title || (item.type === 'express' ? item.pickupLocation || '代取快递' : (item.type === 'partner' ? item.description : (item.from + ' → ' + item.to)))}}</view>
            <view class="mission-meta"><text class="list-price" wx:if="{{item.reward}}">¥{{item.reward}}</text> 🕐 {{item.date || item.time}} {{item.timeSlot || ''}}</view>
          </view>
          <view class="mission-action">></view>
        </view>
      </view>
      <view class="empty-state" wx:if="{{activeTab === 'help' && helpList.length === 0}}"><text class="empty-text">暂无互助信息</text></view>

      <!-- 失物招领 -->
      <view class="mission-list" wx:if="{{activeTab === 'lostfound' && lostfoundList.length > 0}}">
        <view class="mission-item" wx:for="{{lostfoundList}}" wx:key="_id" bindtap="goToDetail" data-type="lostfound" data-id="{{item._id}}" hover-class="mission-item-active">
          <view class="mission-thumb">
            <image wx:if="{{item.images && item.images.length > 0}}" src="{{item.images[0]}}" mode="aspectFill" />
            <text wx:else>{{item.type === 'lost' ? '🔍' : '📦'}}</text>
          </view>
          <view class="mission-body">
            <view class="mission-title">{{item.title}}</view>
            <view class="mission-meta">🕐 {{item.time}}</view>
          </view>
          <view class="mission-action">></view>
        </view>
      </view>
      <view class="empty-state" wx:if="{{activeTab === 'lostfound' && lostfoundList.length === 0}}"><text class="empty-text">暂无失物信息</text></view>

      <!-- 查看更多 -->
      <view class="content-more" bindtap="navigateTo" data-page="{{activeTab === 'market' ? 'market' : (activeTab === 'help' ? 'help' : 'lostfound')}}">查看更多 ></view>
    </view>
  </view>
</view>
