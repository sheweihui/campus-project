<view class="container">

  <!-- 轮播图 -->
  <swiper  
  indicator-dots
  indicator-color
  autoplay
  circular
  wx:if="{{bannerList.length > 0}}">
    <swiper-item wx:for="{{bannerList}}" wx:key="index">
    <image src="{{item}}" mode="aspectFill" style="width: 100%;height: 100%;"/> 
    </swiper-item>
  </swiper>
  <swiper wx:else
  indicator-dots
  indicator-color
  autoplay
  circular>
    <swiper-item>
    <image src="/tabbar/工具.png" mode="aspectFill" style="width: 100%;height: 100%;"/> 
    </swiper-item>
    <swiper-item>
    <image src="/tabbar/我的.png" mode="" style="width: 100%;height: 100%;"/>
    </swiper-item>
    <swiper-item>
    <image src="/tabbar/主页.png" mode="" style="width: 100%;height: 100%;"/>
    </swiper-item>
</swiper>

  <!-- 公告 -->
  <view class="announcement" wx:if="{{announcement.show}}">
    <view class="announcement-icon">📢</view>
    <view class="announcement-content">
      <text class="announcement-title">{{announcement.title}}</text>
      <text class="announcement-text">{{announcement.content}}</text>
    </view>
  </view>

  <!-- 功能模块 -->
  <view class="card">
    <view class="section-title">常用功能</view>
    <view class="grid">
      <view class="grid-item" bindtap="navigateTo" data-page="lostfound">
        <view class="grid-icon lostfound">📋</view>
        <text class="grid-text">失物招领</text>
      </view>
      <view class="grid-item" bindtap="navigateTo" data-page="market">
        <view class="grid-icon market">🛒</view>
        <text class="grid-text">二手集市</text>
      </view>
      <view class="grid-item" bindtap="navigateTo" data-page="help">
        <view class="grid-icon help">🤝</view>
        <text class="grid-text">校园互助</text>
      </view>
      <view class="grid-item" bindtap="navigateTo" data-page="tools">
        <view class="grid-icon tools">🗺️</view>
        <text class="grid-text">校园地图</text>
      </view>
    </view>
  </view>

  <!-- 最新失物招领 -->
  <view class="card" wx:if="{{lostfoundList.length > 0}}">
    <view class="section-header">
      <text class="section-title">最新失物招领</text>
      <text class="more" bindtap="navigateTo" data-page="lostfound">查看更多 ></text>
    </view>
    <view class="weui-cells">
      <view class="weui-cell weui-cell_access" wx:for="{{lostfoundList}}" wx:key="_id" bindtap="goToDetail" data-type="lostfound" data-id="{{item._id}}" hover-class="weui-cell_active">
        <view class="weui-cell__hd">
          <view class="list-thumb">
            <image wx:if="{{item.images && item.images.length > 0}}" src="{{item.images[0]}}" mode="aspectFill" />
            <text wx:else>{{item.type === 'lost' ? '🔍' : '📦'}}</text>
          </view>
        </view>
        <view class="weui-cell__bd">
          <view class="list-title-row">
            <text class="tag {{item.type === 'lost' ? 'tag-warning' : 'tag-primary'}}">{{item.type === 'lost' ? '寻物' : '归还'}}</text>
            <text class="list-title">{{item.title}}</text>
          </view>
          <text class="list-desc">{{item.description}}</text>
          <view class="list-meta"><text>🕐 {{item.time}}</text></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 最新二手商品 -->
  <view class="card" wx:if="{{marketList.length > 0}}">
    <view class="section-header">
      <text class="section-title">最新二手商品</text>
      <text class="more" bindtap="navigateTo" data-page="market">查看更多 ></text>
    </view>
    <view class="weui-cells">
      <view class="weui-cell weui-cell_access" wx:for="{{marketList}}" wx:key="_id" bindtap="goToDetail" data-type="market" data-id="{{item._id}}" hover-class="weui-cell_active">
        <view class="weui-cell__hd">
          <view class="list-thumb">
            <image wx:if="{{item.images && item.images.length > 0}}" src="{{item.images[0]}}" mode="aspectFill" />
            <text wx:else>🛒</text>
          </view>
        </view>
        <view class="weui-cell__bd">
          <view class="list-title-row"><text class="list-title">{{item.title}}</text></view>
          <view class="list-meta">
            <text class="list-price">¥{{item.price}}</text>
            <text>{{conditionMap[item.condition]}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 最新互助信息 -->
  <view class="card" wx:if="{{helpList.length > 0}}">
    <view class="section-header">
      <text class="section-title">最新互助信息</text>
      <text class="more" bindtap="navigateTo" data-page="help">查看更多 ></text>
    </view>
    <view class="weui-cells">
      <view class="weui-cell weui-cell_access" wx:for="{{helpList}}" wx:key="_id" bindtap="goToDetail" data-type="{{item.type}}" data-id="{{item._id}}" hover-class="weui-cell_active">
        <view class="weui-cell__hd"><view class="list-thumb">{{helpIconMap[item.type]}}</view></view>
        <view class="weui-cell__bd">
          <view class="list-title-row">
            <text class="tag tag-primary">{{helpTypeMap[item.type]}}</text>
            <text class="list-title">{{item.title || (item.type === 'express' ? item.pickupLocation || '代取快递' : (item.type === 'partner' ? item.description : (item.from + ' → ' + item.to)))}}</text>
          </view>
          <text class="list-desc" wx:if="{{item.description}}">{{item.description}}</text>
          <text class="list-desc" wx:elif="{{item.remark}}">{{item.remark}}</text>
          <view class="list-meta"><text>{{item.date || item.time}} {{item.timeSlot || ''}}</text></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{lostfoundList.length === 0 && marketList.length === 0 && helpList.length === 0}}">
    <text class="empty-text">暂无数据，快去发布吧！</text>
  </view>
</view>
