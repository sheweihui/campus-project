.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 30rpx;
  color: #666;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab .badge {
  margin-left: 8rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: #f44336;
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.tab.active {
  color: #333333;
  font-weight: bold;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #333333;
  border-radius: 2rpx;
}

.message-list {
  background: #fff;
  border-radius: 16rpx;
  padding: 0 20rpx;
}

.message-item {
  display: flex;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.message-item:last-child {
  border-bottom: none;
}

.message-item.read {
  opacity: 0.6;
}

.message-item.unread {
  background: #f0f9ff;
}

.message-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
}

.message-icon.system {
  background: linear-gradient(135deg, #FF9800, #F57C00);
}

.message-icon.user {
  background: linear-gradient(135deg, #2196F3, #1976D2);
}

.message-content {
  flex: 1;
}

.message-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.message-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.message-time {
  font-size: 24rpx;
  color: #999;
}

.message-body {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.message-status {
  width: 12rpx;
  height: 12rpx;
  background: #f44336;
  border-radius: 50%;
  margin-top: 5rpx;
}
.mark-all-read {
  margin-left: auto;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #1a7f37;
  border: 2rpx solid #1a7f37;
  border-radius: 24rpx;
  background: #fff;
}