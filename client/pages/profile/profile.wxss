.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 20rpx;
  padding-bottom: 120rpx;
}

/* 游客模式提示 */
.guest-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff7e6;
  border: 2rpx solid #ffd591;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.guest-banner-text {
  font-size: 28rpx;
  color: #ad6800;
}

.guest-login-btn {
  background: #ff9900;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 40rpx;
  padding: 12rpx 32rpx;
}

.user-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #f0f1f3;
  box-shadow: none;
}

.user-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-right: 32rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  position: relative;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.avatar-edit-icon {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: #333333;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  border: 2rpx solid #fff;
}

.avatar-text {
  font-size: 56rpx;
  font-weight: bold;
  color: #333333;
}

.user-info {
  flex: 1;
  padding-right: 20rpx;
}

.user-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.user-id,
.user-phone {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
}

.user-id::before,
.user-phone::before {
  content: '';
  width: 8rpx;
  height: 8rpx;
  background: #cccccc;
  border-radius: 50%;
  margin-right: 12rpx;
}

.edit-btn {
  background: #f5f5f5;
  color: #333333;
  padding: 16rpx 36rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  margin-left: auto;
  border: none;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 24rpx;
  position: relative;
  padding-left: 16rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: #333333;
  border-radius: 3rpx;
}

.stats-grid {
  display: flex;
  margin: 0 -12rpx;
}

.stats-item {
  flex: 1;
  text-align: center;
  padding: 32rpx 12rpx;
  background: linear-gradient(145deg, #f8f9fa, #e9ecef);
  border-radius: 16rpx;
  margin: 0 12rpx;
  transition: transform 0.2s;
}

.stats-item:active {
  transform: scale(0.98);
}

.stats-value {
  display: block;
  font-size: 52rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 12rpx;
}

.stats-label {
  display: block;
  font-size: 26rpx;
  color: #666;
}

.function-list {
  margin-top: 8rpx;
}

.function-item {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
  transition: background 0.2s;
}

.function-item:active {
  background: #f8f9fa;
}

.function-item:last-child {
  border-bottom: none;
}

.function-icon {
  font-size: 40rpx;
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: none;
  border-radius: 16rpx;
  margin-right: 24rpx;
}

.function-text {
  flex: 1;
  font-size: 32rpx;
  color: #1a1a1a;
}

.function-arrow {
  font-size: 28rpx;
  color: #999;
}

.badge {
  background: #ff4757;
  color: #fff;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: bold;
  margin-right: 16rpx;
  min-width: 40rpx;
  text-align: center;
}

.about-info {
  margin-top: 8rpx;
}

.about-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.about-item:last-child {
  border-bottom: none;
}

.about-label {
  font-size: 30rpx;
  color: #666;
}

.about-value {
  font-size: 30rpx;
  color: #333;
}

.about-value.contact {
  color: #667eea;
  font-weight: 500;
}
