<view class="container">
  <view class="card">
    <view class="section-title">账号设置</view>

    <view class="weui-cells">
      <!-- 商家端切换（仅管理员） -->
      <view class="weui-cell weui-cell_access" bindtap="goToMerchant" wx:if="{{isAdmin}}" hover-class="weui-cell_active">
        <view class="weui-cell__bd">商家端管理</view>
        <view class="weui-cell__ft">切换到商家端管理后台</view>
      </view>
      <!-- 通知设置 -->
      <view class="weui-cell">
        <view class="weui-cell__bd">消息通知</view>
        <view class="weui-cell__ft"><switch checked="{{settings.messageNotify}}" bindchange="onSettingChange" data-field="messageNotify" /></view>
      </view>
      <!-- 隐私设置 -->
      <view class="weui-cell">
        <view class="weui-cell__bd">公开我的手机号</view>
        <view class="weui-cell__ft"><switch checked="{{settings.showPhone}}" bindchange="onSettingChange" data-field="showPhone" /></view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">意见反馈</view>
    
    <!-- 反馈类型 -->
    <view class="form-item">
      <text class="form-label">反馈类型</text>
      <picker bindchange="onTypeChange" value="{{feedbackTypeIndex}}" range="{{feedbackTypes}}">
        <view class="picker">
          {{feedbackTypes[feedbackTypeIndex]}}
          <text class="picker-arrow">></text>
        </view>
      </picker>
    </view>

    <!-- 反馈内容 -->
    <view class="form-item">
      <text class="form-label">反馈内容 <text class="required">*</text></text>
      <textarea class="form-textarea" placeholder="请详细描述您遇到的问题或建议" value="{{feedback.content}}" bindinput="onFeedbackInput" data-field="content" />
    </view>

    <!-- 联系方式 -->
    <view class="form-item">
      <text class="form-label">联系方式</text>
      <input class="form-input" placeholder="请输入手机号或邮箱" value="{{feedback.contact}}" bindinput="onFeedbackInput" data-field="contact" />
    </view>

    <!-- 提交按钮 -->
    <button class="btn-primary" bindtap="submitFeedback">提交反馈</button>
  </view>

  <view class="card">
    <view class="section-title">其他</view>

    <view class="weui-cells">
      <!-- 清除缓存 -->
      <view class="weui-cell weui-cell_access" bindtap="clearCache" hover-class="weui-cell_active">
        <view class="weui-cell__bd">清除缓存</view>
        <view class="weui-cell__ft">清除本地缓存数据</view>
      </view>
      <!-- 关于我们 -->
      <view class="weui-cell weui-cell_access" bindtap="showAbout" hover-class="weui-cell_active">
        <view class="weui-cell__bd">关于我们</view>
        <view class="weui-cell__ft">版本信息和联系方式</view>
      </view>
      <!-- 退出登录 -->
      <view class="weui-cell weui-cell_access" bindtap="logout" hover-class="weui-cell_active">
        <view class="weui-cell__bd" style="color:#e11d48;">退出登录</view>
        <view class="weui-cell__ft">退出当前账号</view>
      </view>
    </view>
  </view>
</view>
