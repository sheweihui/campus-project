.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-label {
  font-size: 30rpx;
  color: #333;
  flex: 1;
}

.setting-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 5rpx;
}

.setting-info {
  flex: 1;
}

.setting-arrow {
  font-size: 28rpx;
  color: #999;
}

.picker {
  height: 80rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  color: #333;
}

.picker-arrow {
  color: #999;
}

.logout {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.logout .setting-label {
  color: #f44336;
}