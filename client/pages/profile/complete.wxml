<view class="container">
  <view class="card">
    <view class="tip">交易前需要完善你的真实姓名和学号，便于交易双方识别身份。</view>

    <view class="form-item">
      <text class="form-label">真实姓名</text>
      <input class="form-input" placeholder="请输入真实姓名" value="{{name}}" bindinput="onInput" data-field="name" />
    </view>

    <view class="form-item">
      <text class="form-label">学号</text>
      <input class="form-input" placeholder="请输入学号" value="{{stuId}}" bindinput="onInput" data-field="stuId" />
    </view>

    <button class="btn-primary" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">保存并继续</button>
  </view>
</view>
