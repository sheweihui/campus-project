.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.nav-bar {
  display: flex;
  background: #fff;
  border-bottom: 2rpx solid #e0e0e0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.nav-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  border-bottom: 4rpx solid transparent;
}

.nav-item.active {
  color: #333333;
  border-bottom-color: #333333;
  font-weight: bold;
}

.content {
  padding: 20rpx;
}

.tab-content {
  min-height: 80vh;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.post-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.post-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.post-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.post-type {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.post-type.lostfound {
  background: #e3f2fd;
  color: #1976d2;
}

.post-type.market {
  background: #e8f5e9;
  color: #1a7f37;
}

.post-type.help {
  background: #fff3e0;
  color: #f57c00;
}

.post-type.carpool {
  background: #f3e5f5;
  color: #7b1fa2;
}

.post-type.express {
  background: #e0f7fa;
  color: #0097a7;
}

.post-type.partner {
  background: #fff9c4;
  color: #fbc02d;
}

.post-time {
  font-size: 24rpx;
  color: #999;
}

.post-content {
  margin-bottom: 15rpx;
}

.post-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 10rpx;
}

.post-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 10rpx;
}

.post-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #f44336;
}

.post-reward {
  font-size: 28rpx;
  color: #ff9800;
  font-weight: 500;
}

.post-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 15rpx;
  border-top: 1rpx solid #f0f0f0;
}

.post-status {
  font-size: 24rpx;
  color: #999;
}

.post-actions {
  display: flex;
  gap: 15rpx;
}

.action-btn {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.action-btn.edit {
  background: #e3f2fd;
  color: #1976d2;
}

.action-btn.delete {
  background: #ffebee;
  color: #d32f2f;
}