.avatar-section {
  text-align: center;
  padding: 40rpx 0;
  margin-bottom: 30rpx;
}

.avatar-wrapper {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin: 0 auto;
  overflow: hidden;
  border: 4rpx solid #FFFFFF;
}

.avatar-wrapper image {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  color: #999;
}

.avatar-tip {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 22rpx;
  padding: 8rpx 0;
}

.submit-btn {
  margin-top: 40rpx;
}