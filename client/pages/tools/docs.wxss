.container {
  padding: 24rpx;
}

.tip {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 20rpx;
}

.search-bar {
  position: relative;
  margin-bottom: 20rpx;
}

.search-input {
  width: 100%;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 80rpx 0 32rpx;
  font-size: 28rpx;
  color: #333;
}

.search-clear {
  position: absolute;
  top: 50%;
  right: 24rpx;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #cccccc;
  color: #ffffff;
  font-size: 24rpx;
}

.group-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin: 20rpx 4rpx;
}

.doc-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.list-meta {
  flex-direction: column;
  align-items: flex-start;
  line-height: 1.6;
}
