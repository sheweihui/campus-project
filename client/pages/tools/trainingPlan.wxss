.container {
  padding: 24rpx;
}

.plan-header {
  background: #333333;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
  box-shadow: none;
}

.plan-major {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.plan-meta {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.plan-sample {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  background: rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
}

.semester-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.semester-tabs {
  display: flex;
  gap: 16rpx;
}

.semester-tab {
  display: inline-block;
  padding: 14rpx 30rpx;
  background: #fff;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #4b5563;
  border: 1rpx solid #e5e7eb;
}

.semester-tab.active {
  background: #333333;
  color: #fff;
  border-color: transparent;
  font-weight: 600;
}

.semester-summary {
  display: flex;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 20rpx;
}

.course-ft {
  text-align: right;
  display: flex;
  flex-direction: column;
}

.course-credit {
  font-size: 28rpx;
  font-weight: 700;
  color: #e11d48;
}

.course-hours {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.group-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
}

.picker-label {
  font-size: 28rpx;
  color: #333333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-arrow {
  font-size: 28rpx;
  color: #999999;
  margin-left: 16rpx;
}

.doc-open-btn {
  margin-top: 24rpx;
}

.tip {
  font-size: 24rpx;
  color: #999999;
  text-align: center;
  padding: 20rpx 0;
}
