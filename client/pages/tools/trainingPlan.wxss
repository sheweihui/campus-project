.container {
  padding: 24rpx;
}

.plan-header {
  background: #2979ff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(41, 121, 255, 0.25);
}

.plan-major {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.plan-meta {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.plan-sample {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  background: rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
}

.semester-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.semester-tabs {
  display: flex;
  gap: 16rpx;
}

.semester-tab {
  display: inline-block;
  padding: 14rpx 30rpx;
  background: #fff;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #4b5563;
  border: 1rpx solid #e5e7eb;
}

.semester-tab.active {
  background: #2979ff;
  color: #fff;
  border-color: transparent;
  font-weight: 600;
}

.semester-summary {
  display: flex;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 20rpx;
}

.course-ft {
  text-align: right;
  display: flex;
  flex-direction: column;
}

.course-credit {
  font-size: 28rpx;
  font-weight: 700;
  color: #e11d48;
}

.course-hours {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}
