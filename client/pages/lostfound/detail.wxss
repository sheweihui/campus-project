.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.status.pending {
  background: #e8f5e9;
  color: #4CAF50;
}

.status.completed {
  background: #f5f5f5;
  color: #999;
}

.detail-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}

.detail-section {
  margin-bottom: 30rpx;
}

.section-label {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.section-content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
}

.section-content.contact {
  color: #4CAF50;
  font-weight: bold;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-list image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
}

.detail-time {
  font-size: 24rpx;
  color: #999;
  margin-top: 30rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.bar-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  margin: 0 10rpx;
  background: #f0f0f0;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #333;
}

.bar-btn.disabled {
  background: #e0e0e0;
  color: #999;
}

.bar-btn.delete {
  background: #ffebee;
  color: #f44336;
}