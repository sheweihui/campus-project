<view class="container">
  <!-- 标签切换 -->
  <view class="tabs">
    <view class="tab {{currentTab === 'all' ? 'active' : ''}}" bindtap="switchTab" data-tab="all">全部</view>
    <view class="tab {{currentTab === 'lost' ? 'active' : ''}}" bindtap="switchTab" data-tab="lost">寻物</view>
    <view class="tab {{currentTab === 'found' ? 'active' : ''}}" bindtap="switchTab" data-tab="found">归还</view>
  </view>

  <!-- 列表 -->
  <view class="weui-cells">
    <view class="weui-cell weui-cell_access" wx:for="{{list}}" wx:key="_id" bindtap="goToDetail" data-id="{{item._id}}" hover-class="weui-cell_active">
      <view class="weui-cell__hd">
        <view class="list-thumb">
          <image wx:if="{{item.images && item.images.length > 0}}" src="{{item.images[0]}}" mode="aspectFill" />
          <text wx:else>{{item.type === 'lost' ? '🔍' : '📦'}}</text>
        </view>
      </view>
      <view class="weui-cell__bd">
        <view class="list-title-row">
          <text class="tag {{item.type === 'lost' ? 'tag-warning' : 'tag-primary'}}">{{item.type === 'lost' ? '寻物' : '归还'}}</text>
          <text class="list-title">{{item.title}}</text>
          <text class="list-status {{item.status}}">{{item.status === 'pending' ? '进行中' : '已完成'}}</text>
        </view>
        <text class="list-desc">{{item.description}}</text>
        <view class="list-meta">
          <text>📍 {{item.location || '未知地点'}}</text>
          <text>{{item.time || '未知时间'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{!isLoading && hasMore}}">上拉加载更多</view>
  <view class="load-more" wx:if="{{!isLoading && !hasMore && list.length > 0}}">没有更多了</view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!isLoading && list.length === 0}}">
    <text class="empty-text">暂无{{currentTab === 'all' ? '' : (currentTab === 'lost' ? '寻物' : '归还')}}信息</text>
  </view>
</view>

<!-- 发布按钮 -->
<view class="fab" bindtap="goToPublish">
  <text class="fab-icon">+</text>
</view>

<view class="refresh-fab" bindtap="onRefresh">↻</view>
