.container {
  padding: 30rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  color: #333;
}

.finance-overview {
  display: flex;
  justify-content: space-between;
  background: #333333;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.overview-item {
  flex: 1;
  text-align: center;
}

.overview-label {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 10rpx;
}

.overview-value {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.overview-value.commission {
  color: #fff9c4;
}

.overview-value.available {
  color: #81c784;
}

.overview-value.withdrawn {
  color: #999;
}

.action-buttons {
  display: flex;
  gap: 15rpx;
  margin-bottom: 30rpx;
}

.withdraw-btn {
  flex: 1;
}

.withdraw-btn[disabled] {
  background: #e0e0e0;
  color: #999;
}

.record-btn {
  flex: 1;
  background: #fff;
  color: #333333;
  border: 2rpx solid #333333;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
}

.record-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.record-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #f44336;
}

.record-status {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.record-status.pending {
  background: #ff9800;
  color: #fff;
}

.record-status.processing {
  background: #2196f3;
  color: #fff;
}

.record-status.completed {
  background: #333333;
  color: #fff;
}

.record-status.failed {
  background: #f44336;
  color: #fff;
}

.record-time {
  font-size: 24rpx;
  color: #999;
}

.record-detail {
  font-size: 24rpx;
  color: #666;
  margin-top: 10rpx;
}

.withdraw-tips {
  background: #fff9e6;
  border-radius: 12rpx;
  padding: 25rpx;
}

.tips-item {
  font-size: 26rpx;
  color: #666;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.tips-item:last-child {
  border-bottom: none;
}