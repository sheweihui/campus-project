<view class="container">
  <view class="card">
    <view class="section-title">我的财务</view>
    
    <view class="finance-overview">
      <view class="overview-item">
        <text class="overview-label">可提现金额</text>
        <text class="overview-value available">¥{{finance.availableAmount || 0}}</text>
      </view>
      <view class="overview-item">
        <text class="overview-label">已提现金额</text>
        <text class="overview-value withdrawn">¥{{finance.withdrawAmount || 0}}</text>
      </view>
    </view>

    <view class="action-buttons">
      <button class="btn-primary withdraw-btn" bindtap="goToWithdraw" disabled="{{finance.availableAmount < 1}}">
        申请提现
      </button>
      <button class="btn-secondary record-btn" bindtap="goToRecords">
        提现记录
      </button>
    </view>
  </view>

  <view class="card" wx:if="{{finance.withdrawRecords && finance.withdrawRecords.length > 0}}">
    <view class="section-title">提现记录</view>
    <view class="record-list">
      <view class="record-item" wx:for="{{finance.withdrawRecords}}" wx:key="index">
        <view class="record-info">
          <view class="record-amount">-¥{{item.amount}}</view>
          <view class="record-status {{item.status}}">{{withdrawStatusMap[item.status]}}</view>
          <view class="record-time">{{item.time}}</view>
        </view>
        <view class="record-detail" wx:if="{{item.remark}}">
          备注：{{item.remark}}
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">提现说明</view>
    <view class="withdraw-tips">
      <view class="tips-item">1. 最低提现金额：¥1</view>
      <view class="tips-item">2. 提现手续费：免费</view>
      <view class="tips-item">3. 提现到账时间：1-3个工作日</view>
      <view class="tips-item">4. 提现方式：微信转账</view>
    </view>
  </view>
</view>