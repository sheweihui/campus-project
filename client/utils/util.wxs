// WXS 模板辅助函数
function formatAmount(amount) {
  if (amount === null || amount === undefined || amount === '') return '¥0.00'
  var num = parseFloat(amount)
  if (isNaN(num)) return '¥0.00'
  // 按分计算，四舍五入到两位小数
  var cents = Math.round(num * 100)
  var neg = cents < 0
  if (neg) cents = -cents
  var yuan = Math.floor(cents / 100)
  var fen = cents - yuan * 100
  var fenStr = fen < 10 ? '0' + fen : '' + fen
  var yuanStr = '' + yuan
  var out = ''
  var count = 0
  for (var i = yuanStr.length - 1; i >= 0; i--) {
    out = yuanStr.charAt(i) + out
    count++
    if (count % 3 === 0 && i > 0) {
      out = ',' + out
    }
  }
  return (neg ? '-¥' : '¥') + out + '.' + fenStr
}

function formatDate(date) {
  if (!date) {
    var now = getDate()
    return now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate())
  }
  var d = getDate(date)
  return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate())
}

function formatTime(date) {
  if (!date) return ''
  var d = getDate(date)
  return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes())
}

function pad(n) {
  return n < 10 ? '0' + n : '' + n
}

function getOrderTypeName(type) {
  if (type === 'market') return '二手市场'
  if (type === 'lostfound') return '失物招领'
  if (type === 'help') return '校园互助'
  return '其他'
}

function getPaymentStatusName(status) {
  if (status === 'pending') return '待支付'
  if (status === 'paid') return '已支付'
  if (status === 'confirmed') return '已确认'
  return status || '-'
}

function getOrderStatusName(status, paymentStatus) {
  // 兼容历史数据：已支付/已确认的订单一律视为已完成
  if (paymentStatus === 'paid' || paymentStatus === 'confirmed') return '已完成'
  if (status === 'pending') return '进行中'
  if (status === 'completed') return '已完成'
  if (status === 'cancelled') return '已取消'
  return status || '-'
}

function getWithdrawStatusName(status) {
  if (status === 'pending') return '待处理'
  if (status === 'processing') return '处理中'
  if (status === 'completed') return '已完成'
  if (status === 'failed') return '已失败'
  return status || '-'
}

function getStatusTagClass(paymentStatus) {
  if (paymentStatus === 'confirmed') return 'tag-success'
  if (paymentStatus === 'paid') return 'tag-info'
  if (paymentStatus === 'pending') return 'tag-warning'
  return 'tag-default'
}

function getWithdrawTagClass(status) {
  if (status === 'completed') return 'tag-success'
  if (status === 'pending') return 'tag-warning'
  if (status === 'processing') return 'tag-info'
  if (status === 'failed') return 'tag-danger'
  return 'tag-default'
}


function maskOpenid(openid) {
  if (!openid) return ''
  if (openid.length <= 12) return openid
  return openid.slice(0, 12) + '...'
}

function maskBankCard(card) {
  if (!card) return ''
  var c = '' + card
  if (c.length <= 8) return '****' + c.slice(-4)
  return c.slice(0, 4) + ' **** **** ' + c.slice(-4)
}
module.exports = {
  formatAmount: formatAmount,
  formatDate: formatDate,
  formatTime: formatTime,
  getOrderTypeName: getOrderTypeName,
  getPaymentStatusName: getPaymentStatusName,
  getOrderStatusName: getOrderStatusName,
  getWithdrawStatusName: getWithdrawStatusName,
  getStatusTagClass: getStatusTagClass,
  getWithdrawTagClass: getWithdrawTagClass,
  maskOpenid: maskOpenid,
  maskBankCard: maskBankCard
}
